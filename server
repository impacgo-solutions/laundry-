      SELECT
        COUNT(*) as total_pending_deliveries,

        -- Current month count for percentage calculation
        COUNT(*) FILTER (WHERE created_at >= DATE_TRUNC('month', CURRENT_DATE)) as current_month_pending,

        -- Last month count for percentage calculation
        COUNT(*) FILTER (WHERE created_at >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '1 month')
                         AND created_at < DATE_TRUNC('month', CURRENT_DATE)) as last_month_pending
      FROM public.orders
      WHERE status NOT IN ('DELIVERED', 'CANCELLED', 'REJECTED')
        AND (statusbar IS NULL OR LOWER(statusbar) NOT IN ('dropped', 'completed'))
        AND dropped_time IS NULL
    `;

    const result = await pool.query(query);
    const stats = result.rows[0];

    const totalPendingDeliveries = parseInt(stats.total_pending_deliveries) || 0;
    const currentMonthPending = parseInt(stats.current_month_pending) || 0;
    const lastMonthPending = parseInt(stats.last_month_pending) || 0;
    
    // Calculate percentage change from last month
    let percentageChange = 0;
    if (lastMonthPending > 0) {
      percentageChange = ((currentMonthPending - lastMonthPending) / lastMonthPending) * 100;
    } else if (currentMonthPending > 0) {
      percentageChange = 100;
    }

    res.json({
      success: true,
      pending_deliveries: totalPendingDeliveries,
      current_month_pending: currentMonthPending,
      last_month_pending: lastMonthPending,
      percentage_change: percentageChange,
      message: 'Pending deliveries count retrieved successfully'
    });
    
  } catch (error) {
    console.error('Error fetching pending deliveries count:', error);
    res.status(500).json({
      success: false,
      error: 'Internal server error',
      message: error.message
    });
  }
});
