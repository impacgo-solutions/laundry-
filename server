    let driverPhone = result.rows[0].driver_phone;
    let customerPhone = result.rows[0].customer_phone;

    console.log("📱 Driver Phone:", driverPhone);
    console.log("👤 Customer Phone:", customerPhone);

    if (!driverPhone || !customerPhone) {
      return res.status(400).json({
        success: false,
        message: "Phone numbers missing"
      });
    }

    // ===============================
    // 2️⃣ Get available RC number
    // ===============================

    const rc = await pool.query(`
      SELECT * FROM ringcentral_numbers
      WHERE status='available'
      LIMIT 1
    `);

    if (rc.rows.length === 0) {
      console.log("❌ No RingCentral numbers available");

      return res.status(500).json({
        success: false,
        message: "No RC numbers available"
      });
    }

    const rcNumber = rc.rows[0].phone_number;

    console.log("☎️ Using RC Number:", rcNumber);

    // mark busy
    await pool.query(`
      UPDATE ringcentral_numbers
      SET status='busy'
      WHERE phone_number=$1
    `, [rcNumber]);

    console.log("✅ RC number marked busy");

    // ===============================
    // 3️⃣ Login to RingCentral
    // ===============================

    console.log("🔐 Logging into RingCentral...");

    await loginToRingCentral();

    console.log("✅ RingCentral login success");

    // ===============================
    // 4️⃣ Trigger RingOut
    // ===============================

    console.log("📞 Calling driver then customer...");

    const response = await platform.post(
      "/restapi/v1.0/account/~/extension/~/ring-out",
      {
        from: {
          phoneNumber: driverPhone
        },
        to: {
          phoneNumber: customerPhone
        },
        callerId: {
          phoneNumber: rcNumber
        },
        playPrompt: false
      }
    );

    const data = await response.json();

    console.log("✅ RingOut Response:", data);

    // ===============================
    // 5️⃣ Save call session
    // ===============================

    await pool.query(`
      INSERT INTO ringcentral_call_sessions
      (order_id, driver_id, ringcentral_number, status)
      VALUES ($1,$2,$3,'initiated')
    `, [order_id, driver_id, rcNumber]);

    console.log("💾 Call session saved");

    // ===============================
    // 6️⃣ Response
    // ===============================

    res.json({
      success: true,
      message: "Call initiated",
      rc_number: rcNumber
    });

  } catch (error) {

    console.error("❌ RingCentral Error:", error);

    res.status(500).json({
      success: false,
      message: "Call failed"
    });

  }

});

