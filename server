app.post('/api/orders/:orderId/accept', authenticateManager, async (req, res) => {
  const { orderId } = req.params;
  const { manager_id } = req.body;

  if (!manager_id) return res.status(400).json({ error: 'Manager ID is required' });

  const client = await pool.connect();
  try {
    await client.query('BEGIN');

    const { rows: orderRows } = await client.query(
      `SELECT id, user_id, status FROM orders WHERE id = $1 FOR UPDATE`,
      [orderId]
    );
    if (!orderRows.length) {
      await client.query('ROLLBACK');
      return res.status(404).json({ error: 'Order not found' });
    }

    const order = orderRows[0];
    if (order.status !== 'NEW') {
      await client.query('ROLLBACK');
      return res.status(409).json({ error: 'Order already accepted or not NEW' });
    }

    const { rows: updated } = await client.query(
      `UPDATE orders
       SET manager_id = $1,
           status = 'COLLECT'
       WHERE id = $2
       RETURNING *`,
      [manager_id, orderId]
    );

    await client.query(
      `UPDATE customers
       SET assigned_manager_id = $1
       WHERE id = $2 AND assigned_manager_id IS NULL`,
      [manager_id, order.user_id]
    );

    await client.query('COMMIT');
    res.json({ message: 'Order accepted successfully by manager', order: updated[0] });
  } catch (err) {
    await client.query('ROLLBACK');
    console.error('Manager accept error:', err);
    res.status(500).json({ error: 'Server Error' });
  } finally {
    client.release();
  }
});

