// GET: Fetch approval requests for a specific order. Called by both the
// customer app (with a Bearer token) and the lsp manager app (with none at
// all, e.g. priceapproval.dart/approverequest.dart) - a hard `authenticate`
// requirement would 401 the manager screens, so auth is enforced only when
// a customer token is actually presented: a customer can never use their own
// valid token to read another customer's approval requests (price/damage
// notes, amounts, images) by guessing an order id, which was previously wide
// open to anyone with no auth at all.
app.get("/approvalrequests/:order_id", async (req, res) => {
  try {
    const { order_id } = req.params;
    // Reached by three different callers with three different token shapes:
    // the customer app (customer JWT, decoded.userId - must own the order),
    // and lsp for both managers and drivers (decoded.id + decoded.role -
    // staff handling the order, not its owner, so no ownership check applies
    // to them). This used to only check ownership when a header happened to
    // be present at all, so calling with NO header at all bypassed the check
    // entirely and returned another customer's approval history to anyone.
    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return res.status(401).json({ error: 'Authorization token required' });
    }
    let decoded;
    try {
      decoded = jwt.verify(authHeader.split(' ')[1], JWT_SECRET);
    } catch (err) {
      return res.status(401).json({ error: 'Invalid or expired token' });
    }
    if (decoded.role !== 'manager' && decoded.role !== 'driver') {
      const ownerCheck = await pool.query('SELECT user_id FROM orders WHERE id = $1', [order_id]);
      if (ownerCheck.rows.length === 0) {
        return res.status(404).json({ error: 'Order not found' });
      }
      if (ownerCheck.rows[0].user_id !== decoded.userId) {
        return res.status(403).json({ error: 'You do not have permission to view this order' });
      }
    }

    const result = await pool.query(
      "SELECT * FROM approval_requests WHERE order_id = $1 ORDER BY created_at DESC",
      [order_id]
    );

    res.status(200).json({
      success: true,
      count: result.rows.length,
      data: result.rows,
    });
  } catch (error) {
    console.error("❌ Error fetching approval requests by order:", error);
    res.status(500).json({ error: "Failed to fetch approval requests" });
  }
});


