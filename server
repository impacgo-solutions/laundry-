app.get("/dashboard", async (req, res) => {
  const managerId = req.query.managerId;

  try {
    if (!managerId) {
      return res.status(400).json({ error: "managerId is required" });
    }

    // ✅ Step 1: SQL Query – get all orders for the manager or new ones
    const query = `
      SELECT 
        o.id AS order_id,
        o.user_id,
        o.manager_id,
        o.status,
        o.subtotal,
        o.tip,
        o.total,
        o.collect_slot,
        o.delivery_slot,
        o.created_at,
        o.picked_time,
        o.prelaundry_time,
        o.postlaundry_time,
        o.dropped_time,
        c.name AS customer_name,
        a.full_address AS address,
        a.postcode
      FROM public.orders o
      LEFT JOIN public.customers c ON o.user_id = c.id
      LEFT JOIN public.addresses a ON o.address_id = a.address_id
      WHERE (o.manager_id = $1 OR LOWER(o.status) = 'new')
      ORDER BY o.created_at DESC;
    `;

    const { rows } = await pool.query(query, [managerId]);

    // ✅ Step 2: Grouping Logic
    const newOrders = []; // "Accepted" tab
    const picked = []; // "Picked" tab
    const laundryProcess = []; // "Laundry Processing" tab
    const readyForDelivery = []; // "Ready for Delivery" tab
    const allOrders = []; // "All" tab

    for (const o of rows) {
      const status = (o.status || "").toLowerCase();

      // --- Case 1: Completed or Dropped ---
      if (o.dropped_time || ["dropped", "completed"].includes(status)) {
        allOrders.push(o);
        continue;
      }

      // --- Case 2: Ready for Delivery (based on timestamp) ---
      if (o.postlaundry_time && !o.dropped_time) {
        readyForDelivery.push(o);
        continue;
      }

      // --- Case 3: In Laundry Processing (based on timestamp) ---
      if (o.prelaundry_time && !o.postlaundry_time) {
        laundryProcess.push(o);
        continue;
      }

      // --- Case 4: Picked but not yet in laundry ---
      if (o.picked_time && !o.prelaundry_time && !o.postlaundry_time) {
        picked.push(o);
        continue;
      }

      // --- Case 5: Newly Accepted ---
      if (status === "new" && !o.picked_time) {
        newOrders.push(o);
        continue;
      }

      // --- Default fallback ---
      allOrders.push(o);
    }

    // ✅ Step 3: Send response
    return res.json({
      success: true,
      message: "Dashboard data fetched successfully",
      new: newOrders, // Accepted tab (New Orders)
      accepted: picked, // Picked tab
      laundry_process: laundryProcess, // Laundry Processing tab
      ready_for_delivery: readyForDelivery, // Ready For Delivery tab
      all: allOrders, // All tab
    });
  } catch (error) {
    console.error("❌ Error fetching dashboard:", error);
    return res.status(500).json({ error: "Internal server error" });
  }
});
