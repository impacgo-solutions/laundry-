app.get('/admin/customers', async (req, res) => {
  try {
    const { page = 1, limit = 10, search = '' } = req.query;
    const offset = (page - 1) * limit;

    let searchCondition = '';
    let queryParams = [limit, offset];
    
    if (search) {
      searchCondition = `WHERE (c.id::text ILIKE $3 OR c.name ILIKE $3 OR c.email ILIKE $3)`;
      queryParams.push(`%${search}%`);
    }

    const query = `
      WITH LatestOrders AS (
        SELECT
          o.user_id,
          o.id as order_id,
          o.created_at as date,
          o.statusbar as status,
          o.status as overall_status,
          ROW_NUMBER() OVER (PARTITION BY o.user_id ORDER BY o.created_at DESC) as rn
        FROM orders o
      )
      SELECT
        c.id as customer_id,
        c.name as customer_name,
        c.email,
        c.phone,
        lo.order_id,
        TO_CHAR(lo.date, 'Mon DD, YYYY') as formatted_date,
        lo.status,
        lo.overall_status,
        COUNT(*) OVER() as total_customers
      FROM customers c
      LEFT JOIN LatestOrders lo ON c.id = lo.user_id AND lo.rn = 1
      ${searchCondition}
      ORDER BY c.created_at DESC
      LIMIT $1 OFFSET $2
    `;

    const result = await pool.query(query, queryParams);

    const customers = result.rows.map(row => ({
      customer_id: row.customer_id,
      customer_name: row.customer_name,
      email: row.email,
      phone: row.phone,
      latest_order: {
        order_id: row.order_id ? `#ORD-${row.order_id}` : 'No orders',
        date: row.formatted_date || 'No orders',
        // statusbar (row.status) is a stage marker that's frequently NULL for
        // early-stage orders (e.g. a brand new order awaiting pickup) - using
        // it alone as "the" status showed "No orders" for customers who very
        // much had an order, just not yet a granular stage. Fall back to the
        // order's actual status (NEW/COLLECT/DELIVERED/...) instead, and only
        // say "No orders" when there truly is no order_id at all. But a
        // terminal state (cancelled/rejected/delivered) must always win -
        // otherwise a cancelled order that had already progressed keeps
        // showing its stale in-progress stage forever.
        status: (() => {
          if (!row.order_id) return 'No orders';
          const overall = (row.overall_status || '').toUpperCase();
          if (['CANCELLED', 'REJECTED', 'DELIVERED'].includes(overall)) return row.overall_status;
          return row.status || row.overall_status || 'N/A';
        })()
      }
    }));

    res.json({
      success: true,
      customers,
      totalCustomers: result.rows[0]?.total_customers || 0
    });

  } catch (error) {
    console.error('Error fetching customers:', error);
    res.status(500).json({ 
      success: false, 
      error: 'Internal server error' 
    });
  }
});
