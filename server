    const query1 = `
      SELECT lm.fcm_token, lm.user_id as manager_id, lm.name, lm.username
      FROM public.approval_requests ar
      JOIN public.laundrymanager lm ON ar.manager_id = lm.user_id
      WHERE ar.id = $1;
    `;

    let result = await pool.query(query1, [parseInt(approvalId)]);

    // If no manager found in approval_requests, get any active manager
