app.post("/stripe/charge-invoice", authenticate, async (req, res) => {
  try {
    const { invoice_id } = req.body;

    const inv = await pool.query(
      "SELECT customer_id, total_amount, status FROM invoice WHERE invoice_id=$1",
      [invoice_id]
    );

    if (!inv.rows.length)
      return res.status(404).json({ error: "Invoice not found" });

    const invoice = inv.rows[0];

    // Prevent double charge
    if (invoice.status === "paid") {
      return res.json({ success: false, message: "Invoice already paid" });
    }

    const cust = await pool.query(
      "SELECT stripe_customer_id FROM customers WHERE id=$1",
      [invoice.customer_id]
    );

    const stripeCustomerId = cust.rows[0]?.stripe_customer_id;

    if (!stripeCustomerId)
      return res.json({ error: "Stripe customer not found" });

    const amount = Math.round(Number(invoice.total_amount) * 100);

    const stripeCustomer = await stripe.customers.retrieve(stripeCustomerId);

    let paymentMethodId =
      stripeCustomer.invoice_settings?.default_payment_method;

    if (!paymentMethodId) {
      const methods = await stripe.paymentMethods.list({
        customer: stripeCustomerId,
        type: "card",
      });

      if (!methods.data.length)
        return res.json({ error: "No saved cards found" });

      paymentMethodId = methods.data[0].id;
    }

    const pi = await stripe.paymentIntents.create(
      {
        amount,
        currency: "inr",
        customer: stripeCustomerId,
        payment_method: paymentMethodId,
        off_session: true,
        confirm: true,
        payment_method_types: ["card"],

        metadata: {
          invoice_id: invoice_id,
          system: "impacgo",
        },
      },
      {
        idempotencyKey: `invoice_${invoice_id}`,
      }
    );

    const invoiceStatus = pi.status === "succeeded" ? "paid" : "unpaid";

    await pool.query(
      `UPDATE invoice
       SET stripe_payment_intent_id=$1,
           status=$2,
           payment_method='card'
       WHERE invoice_id=$3`,
      [pi.id, invoiceStatus, invoice_id]
    );

    res.json({ success: true, status: pi.status });
  } catch (err) {
    console.error("Charge Invoice ERROR:", err);
    res.status(500).json({ error: err.message });
  }
});
