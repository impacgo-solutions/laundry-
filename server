app.post("/call-customer", async (req, res) => {
  const client = await pool.connect();
  try {
    const { driver_id, order_id } = req.body;

    if (!driver_id || !order_id) {
      return res.status(400).json({ success: false, message: "driver_id and order_id required" });
    }

    // 1) Get driver/customer phones and ids from DB (adjust column names as necessary)
    const orderQ = await pool.query(
      `SELECT o.id as order_id, o.driver_id, o.customer_id,
              d.phone as driver_phone, c.phone as customer_phone
       FROM orders o
       LEFT JOIN drivers d ON o.driver_id = d.id
       LEFT JOIN customers c ON o.customer_id = c.id
       WHERE o.id = $1`,
      [order_id]
    );

    if (orderQ.rows.length === 0) {
      return res.status(404).json({ success: false, message: "Order not found" });
    }

    const row = orderQ.rows[0];
    let driverPhone = row.driver_phone || '';
    let customerPhone = row.customer_phone || '';

    // Normalize phone numbers to E.164 if they look local (simple heuristic)
    function normalizeToE164(num) {
      if (!num) return '';
      num = num.toString().trim();
      if (num.startsWith('+')) return num;
      // assume India 10-digit local
      if (/^\d{10}$/.test(num)) return '+91' + num;
      // already has country code without +
      if (/^\d{11,15}$/.test(num)) return '+' + num;
      return num;
    }

    driverPhone = normalizeToE164(driverPhone);
    customerPhone = normalizeToE164(customerPhone);

    if (!driverPhone || !customerPhone) {
      return res.status(400).json({ success: false, message: "Driver or customer phone missing in DB" });
    }

    // 2) Pick one available RingCentral number atomically (use transaction + FOR UPDATE SKIP LOCKED)
    await client.query("BEGIN");

    const pickQ = await client.query(
      `SELECT id, phone_number
       FROM ringcentral_numbers
       WHERE status = 'available'
       LIMIT 1
       FOR UPDATE SKIP LOCKED`
    );

    if (pickQ.rows.length === 0) {
      await client.query("ROLLBACK");
      return res.status(409).json({ success: false, message: "No RingCentral number available" });
    }

    const rcRow = pickQ.rows[0];
    const rcId = rcRow.id;
    const rcNumber = rcRow.phone_number;

    // mark number busy
    await client.query(
      `UPDATE ringcentral_numbers SET status='busy' WHERE id=$1`,
      [rcId]
    );

    // create call session record
    const insertSessionQ = await client.query(
      `INSERT INTO ringcentral_call_sessions
         (order_id, driver_id, customer_id, ringcentral_number, status, started_at)
       VALUES ($1,$2,$3,$4,'initiated', NOW())
       RETURNING id`,
      [order_id, driver_id, row.customer_id, rcNumber]
    );

    const sessionId = insertSessionQ.rows[0].id;

    await client.query("COMMIT");

    // 3) Login to RingCentral
    await loginToRingCentral(); // uses your existing function

    // 4) Start RingOut to the driver (driver rings first). Use callerId or from as RC number.
    // Note: we call the driver first. After driver answers you'll need a webhook to call the customer.
    const resp = await platform.post(
      `/restapi/v1.0/account/~/extension/${RC_TEST_EXTENSION}/ring-out`,
      {
        from: { phoneNumber: rcNumber },
        to: { phoneNumber: driverPhone },
        callerId: { phoneNumber: rcNumber },
        playPrompt: false
      }
    );

    const rcResp = await resp.json().catch(()=>({}));

    // optional: save external_call_id if you added column
    if (rcResp && rcResp.id) {
      try {
        await pool.query(
          `UPDATE ringcentral_call_sessions SET external_call_id=$1 WHERE id=$2`,
          [rcResp.id, sessionId]
        );
      } catch (e) {
        console.warn("Failed to update external_call_id:", e);
      }
    }

    // Return session info to caller
    return res.json({
      success: true,
      session_id: sessionId,
      ringcentral_number: rcNumber,
      external_call_id: rcResp.id || null
    });

  } catch (err) {
    try { await client.query("ROLLBACK"); } catch(_) {}
    console.error("call-customer error:", err);
    return res.status(500).json({ success: false, message: "Failed to initiate call", error: err.message || err });
  } finally {
    client.release();
  }
});
