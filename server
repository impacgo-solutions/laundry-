// GET /customer-by-phone

// Matches EXACT schema:

//   customers  → id (uuid), name, email, phone  [index: lower(phone)]

//   addresses  → address_id, user_id (uuid), address_type, full_address,

//                additional_details, postcode, pincode

//   orders     → id, user_id (uuid), collect_slot, delivery_slot, notes,

//                status, created_at

// ─────────────────────────────────────────────────────────────────────────────
 
app.get('/customer-by-phone', async (req, res) => {
  const { phone } = req.query;
  if (!phone || typeof phone !== 'string' || phone.trim().length < 5) {
    return res.status(400).json({
      success: false,
      customer: null,
      message: 'Phone number is required',
    });
  }
  try {
    const phoneInput = phone.trim();
    // ── STEP 1: Find customer by phone ────────────────────────────────────
    // DB has unique index on lower(phone), also try without country code
    const customerResult = await pool.query(
      `SELECT id, name, email, phone
         FROM customers
        WHERE lower(phone) = lower($1)
           OR lower(phone) = lower($2)
        LIMIT 1`,
      [phoneInput, phoneInput.replace(/^\+\d{1,3}/, '')]
    );
    if (customerResult.rows.length === 0) {
      return res.status(404).json({
        success: false,
        customer: null,
        message: `No customer found for "${phoneInput}"`,
      });
    } 
    const customer   = customerResult.rows[0];
    const customerId = customer.id;
    // ── STEP 2: Get all addresses for this customer ───────────────────────
    const addressResult = await pool.query(
      `SELECT
          address_id,
          address_type,
          full_address,
          additional_details,
          postcode,
          pincode
         FROM addresses
        WHERE user_id = $1::uuid
        ORDER BY
          CASE
            WHEN address_type = 'pickup'   THEN 1
            WHEN address_type = 'delivery' THEN 2
            ELSE 3
          END,
          address_id DESC`,
      [customerId]
    );
 
    // ── STEP 3: Get last order for notes reference ────────────────────────
    const lastOrderResult = await pool.query(
      `SELECT
          id,
          collect_slot,
          delivery_slot,
          notes,
          status,
          created_at
         FROM orders
        WHERE user_id = $1::uuid
        ORDER BY created_at DESC
        LIMIT 1`,
      [customerId]
    );
 
    const addresses = addressResult.rows;
    const lastOrder = lastOrderResult.rows[0] || null;
    // ── STEP 4: Resolve pickup vs delivery address ────────────────────────
    const pickupAddress = addresses.find(a => a.address_type === 'pickup')
                       || addresses[0]
                       || null;
    const deliveryAddress = addresses.find(a => a.address_type === 'delivery')
                          || null;
    const hasDifferentDelivery =
      deliveryAddress !== null &&
      pickupAddress   !== null &&
      deliveryAddress.address_id !== pickupAddress.address_id &&
      (deliveryAddress.postcode || '').replace(/\s/g, '').toUpperCase() !==
      (pickupAddress.postcode   || '').replace(/\s/g, '').toUpperCase();
    return res.json({
      success: true,
      message: 'Customer found',
      customer: {
        id   : customer.id,
        name : customer.name  || '',
        email: customer.email || '',
        phone: customer.phone || '',
      },
      pickup_address: pickupAddress ? {
        address_id        : pickupAddress.address_id,
        full_address      : pickupAddress.full_address       || '',
        postcode          : pickupAddress.postcode || pickupAddress.pincode || '',
        additional_details: pickupAddress.additional_details || '',
      } : null,
      delivery_address: hasDifferentDelivery ? {
        address_id        : deliveryAddress.address_id,
        full_address      : deliveryAddress.full_address       || '',
        postcode          : deliveryAddress.postcode || deliveryAddress.pincode || '',
        additional_details: deliveryAddress.additional_details || '',
      } : null,
      use_same_address: !hasDifferentDelivery,
      last_order: lastOrder ? {
        id           : lastOrder.id,
        collect_slot : lastOrder.collect_slot  || '',
        delivery_slot: lastOrder.delivery_slot || '',
        notes        : lastOrder.notes         || '',
        status       : lastOrder.status        || '',
        created_at   : lastOrder.created_at,
      } : null,
    });
 
  } catch (error) {
    console.error('Error fetching customer by phone:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});
