app.put('/addresses/:id', authenticate, async (req, res) => {
  const { id } = req.params;
  const { name, phone, house_number, street_name, postcode, full_address, pincode, address_type, latitude, longitude, additional_details } = req.body;
  const userId = req.user.id;

  try {
    await pool.query('BEGIN');

    // 1. Update customers table (name & phone)
    if (name || phone) {
      const updateCustomerQuery = `
        UPDATE customers
        SET name = COALESCE($1, name),
            phone = COALESCE($2, phone)
        WHERE id = $3
      `;
      await pool.query(updateCustomerQuery, [name, phone, userId]);
    }

    // 2. Update addresses table (all fields)
    const updateAddressQuery = `
      UPDATE addresses
      SET house_number      = COALESCE($1, house_number),
          street_name       = COALESCE($2, street_name),
          postcode          = COALESCE($3, postcode),
          full_address      = COALESCE($4, full_address),
