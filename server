app.get("/lm/orders", async (req, res) => {
  try {
    const {
      managerId,
      cursorCreatedAt,
      cursorId,
      limit = 10,
    } = req.query;

    if (!managerId) {
      return res
        .status(400)
        .json({ error: "Manager ID query parameter is required." });
    }

    const pageLimit = parseInt(limit);
    const params = [managerId];
    let cursorCondition = "";

    // ✅ Cursor condition (KEYSET PAGINATION)
    if (cursorCreatedAt && cursorId) {
      params.push(cursorCreatedAt, cursorId);
      cursorCondition = `
        AND (
          o.created_at < $${params.length - 1}
          OR (
            o.created_at = $${params.length - 1}
            AND o.id < $${params.length}
          )
        )
      `;
    }

    // limit + 1 to detect hasMore
    params.push(pageLimit + 1);

    const query = `
      SELECT
        o.id AS order_id,
        c.name AS customer_name,
        a.full_address,
        o.collect_slot,
        o.statusbar,
        o.created_at
      FROM orders o
      JOIN customers c ON o.user_id = c.id
      JOIN addresses a ON o.address_id = a.address_id
      WHERE
        o.manager_id = $1
        -- This list feeds the Quality Check screen's "Review" button, whose
        -- detail endpoint (/manager/orders/id) only ever returns orders whose
        -- status is 'COLLECT' - a laundry can't be quality-checked before it's
        -- been picked up. Without this filter, NEW/CANCELLED/DELIVERED orders
        -- showed a "Review" button that opened to a permanently blank screen.
        AND o.status = 'COLLECT'
        ${cursorCondition}
      ORDER BY o.created_at DESC, o.id DESC
      LIMIT $${params.length};
    `;

    const result = await pool.query(query, params);

    let rows = result.rows;
    const hasMore = rows.length > pageLimit;

    if (hasMore) rows.pop();

    const lastRow = rows[rows.length - 1];

    res.json({
      orders: rows,
      nextCursor: lastRow
        ? {
            created_at: lastRow.created_at,
            id: lastRow.order_id,
          }
        : null,
      hasMore,
    });
  } catch (error) {
    console.error("Cursor pagination error:", error);
    res.status(500).json({ error: "Server error" });
  }
});



