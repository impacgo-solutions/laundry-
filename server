app.get('/admin/driver/:driverId/orders/performance', async (req, res) => {
  try {
    const { driverId } = req.params;
    const query = `
      SELECT
        o.id AS order_id,
        o.collect_slot,
        o.delivery_slot,
        TO_CHAR(o.picked_time, 'HH24:MI') AS picked_time,
        TO_CHAR(o.dropped_time, 'HH24:MI') AS dropped_time,
        ROUND(
          EXTRACT(EPOCH FROM (
            o.picked_time -
            (DATE(o.created_at) + split_part(o.collect_slot, '-', 2)::time)
          )) / 60
        ) AS pickup_delay_minutes,
        ROUND(
          EXTRACT(EPOCH FROM (
            o.dropped_time -
            (DATE(o.created_at) + split_part(o.delivery_slot, '-', 2)::time)
          )) / 60
        ) AS delivery_delay_minutes
      FROM orders o
      WHERE o.driver_id = $1
      ORDER BY o.created_at DESC;
    `;

    const result = await pool.query(query, [driverId]);

    const orders = result.rows.map(r => ({
      order_id: r.order_id,
      collect_slot: r.collect_slot,
      delivery_slot: r.delivery_slot,
      picked_time: r.picked_time ?? '—',
      dropped_time: r.dropped_time ?? '—',

      pickup_status:
        r.pickup_delay_minutes == null
          ? 'Not picked'
          : r.pickup_delay_minutes > 0
            ? `Late by ${r.pickup_delay_minutes} min`
            : `Early by ${Math.abs(r.pickup_delay_minutes)} min`,

      delivery_status:
        r.delivery_delay_minutes == null
          ? 'Not delivered'
          : r.delivery_delay_minutes > 0
            ? `Late by ${r.delivery_delay_minutes} min`
            : `Early by ${Math.abs(r.delivery_delay_minutes)} min`
    }));

    res.json({
      success: true,
      driver_id: driverId,
      orders
    });

  } catch (error) {
    console.error(error);
    res.status(500).json({
      success: false,
      error: 'Internal server error'
    });
  }
});

