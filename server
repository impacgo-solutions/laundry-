      customer_id: order.user_id,
      customer_name: order.customer_name,
      email: order.email,
      phone: order.phone,
      date: order.date,
      // statusbar alone would keep showing a stale in-progress stage
      // forever once an order is cancelled/rejected/delivered - a terminal
      // overall_status must win over it.
      status: ['CANCELLED', 'REJECTED', 'DELIVERED'].includes((order.overall_status || '').toUpperCase())
        ? order.overall_status
        : (order.status || order.overall_status || 'N/A'),
      address: formattedAddress || 'No address provided',
      timing: {
        collect_slot: order.collect_slot,
        delivery_slot: order.delivery_slot,
        more_time_keeping: order.more_time_keeping
      },
      summary: {
