app.post("/submitFeedback", async (req, res) => {
  const client = await pool.connect();

  try {
    const { orderId, rating, comments, additionalFeedback } = req.body;
    const userId = req.user?.id;

    if (!orderId || !rating) {
      return res.status(400).json({
        success: false,
        error: "Order ID and rating are required",
      });
    }

    await client.query("BEGIN");

    // 1️⃣ Validate order belongs to user & not already reviewed
    const orderCheck = await client.query(
      `
      SELECT id, feedback_submitted
      FROM orders
      WHERE id = $1 AND user_id = $2
      FOR UPDATE
      `,
      [orderId, userId]
    );

    if (orderCheck.rows.length === 0) {
      throw new Error("Order not found or access denied");
    }

    if (orderCheck.rows[0].feedback_submitted === true) {
      throw new Error("Feedback already submitted for this order");
    }

    // 2️⃣ Update order status + feedback flag
    const updateOrder = await client.query(
      `
      UPDATE orders
      SET
        statusbar = 'FEEDBACK_SUBMITTED',
        feedback_submitted = true
      WHERE id = $1
      RETURNING *;
      `,
      [orderId]
    );

    // 3️⃣ Insert feedback
    const insertFeedback = await client.query(
      `
      INSERT INTO feedback (
        order_id,
        user_id,
        rating,
        comments,
        additional_feedback
      )
      VALUES ($1, $2, $3, $4, $5)
      RETURNING *;
      `,
      [
        orderId,
        userId,
        rating,
        comments || null,
        additionalFeedback || null,
      ]
    );

    await client.query("COMMIT");

    return res.json({
      success: true,
      message: "Feedback submitted successfully",
      order: updateOrder.rows[0],
      feedback: insertFeedback.rows[0],
    });
  } catch (err) {
    await client.query("ROLLBACK");

    console.error("❌ Feedback error:", err.message);

    return res.status(400).json({
      success: false,
      error: err.message,
    });
  } finally {
    client.release();
  }
});

