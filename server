app.post("/orders/:orderId/items/add", async (req, res) => {
  const client = await pool.connect();
  try {
    const orderId = parseInt(req.params.orderId, 10);
    const { products } = req.body; // now expecting { products: [{product_id, qty, price}, ...] }

    if (!orderId || !products || !Array.isArray(products) || products.length === 0) {
      return res.status(400).json({ message: "Missing or invalid fields" });
    }

    await client.query("BEGIN");

    for (const p of products) {
      const { product_id, qty, price } = p;
      const existingItem = await client.query(
        "SELECT * FROM order_items WHERE order_id = $1 AND product_id = $2",
        [orderId, product_id]
      );

      if (existingItem.rowCount > 0) {
        await client.query(
          "UPDATE order_items SET quantity = quantity + $1 WHERE order_id = $2 AND product_id = $3",
          [qty, orderId, product_id]
        );
      } else {
        await client.query(
          `INSERT INTO order_items (order_id, product_id, quantity, price_at_purchase)
           VALUES ($1, $2, $3, $4)`,
          [orderId, product_id, qty, price]
        );
      }
    }

    // Recalculate subtotal
    const subtotalResult = await client.query(
      `SELECT SUM(quantity * price_at_purchase) AS subtotal
       FROM order_items
       WHERE order_id = $1`,
      [orderId]
    );

    const subtotal = subtotalResult.rows[0].subtotal || 0;

    // Update orders table
    const updatedOrder = await client.query(
      `UPDATE orders
       SET subtotal = $1,
           total = $1 + tip
       WHERE id = $2
       RETURNING *`,
      [subtotal, orderId]
    );

    await client.query("COMMIT");

    res.json({
      message: "Order updated successfully",
      updatedOrder: updatedOrder.rows[0],
    });
  } catch (error) {
    await client.query("ROLLBACK");
    console.error(error);
    res.status(500).json({ message: "Internal Server Error", error: error.message });
  } finally {
    client.release();
  }
});

app.post("/api/orders/updateStatusdelivery", authenticateDriverOrManager, async (req, res) => {
  try {
    const { orderId, status } = req.body;

    if (!orderId || !status) {
      return res.status(400).json({ error: "Missing orderId or status" });
    }

    // Delivery is the other moment that needs an audit timestamp - without
    // it there's no record of when an order was actually completed.
    const normalizedStatus = status.toLowerCase();
    const isDelivered = normalizedStatus === "delivered" || normalizedStatus === "completed";

    // This had no state-transition validation at all - any order, even one
    // that was never picked up, could be force-marked delivered via a direct
    // API call. Marking delivery is only meaningful once an order has
    // actually been collected.
    if (isDelivered) {
      const current = await pool.query("SELECT status FROM orders WHERE id = $1", [orderId]);
      if (current.rows.length === 0) {
        return res.status(404).json({ error: "Order not found" });
      }
      const currentStatus = (current.rows[0].status || "").toUpperCase();
      if (currentStatus !== "COLLECT") {
        return res.status(400).json({ error: `Cannot mark order delivered from status ${currentStatus}` });
      }
    }

    const query = `
      UPDATE orders
      SET status = $1,
          dropped_time = CASE WHEN $3 THEN NOW() ELSE dropped_time END
      WHERE id = $2
      RETURNING *;
    `;

    const { rows } = await pool.query(query, [status, orderId, isDelivered]);

    if (rows.length === 0) {
      return res.status(404).json({ error: "Order not found" });
    }

    res.json({ success: true, updatedOrder: rows[0] });
  } catch (err) {
    console.error("❌ Error updating status:", err.message);
    res.status(500).json({ error: err.message });
  }
});
