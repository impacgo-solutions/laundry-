app.post("/driver/request-approval", authenticateDriverOrManager, async (req, res) => {
  try {
    const { order_id, driver_id, request_type, note, slot_start, slot_end } = req.body;

    if (!order_id || !driver_id || !request_type) {
      return res.status(400).json({ message: "Missing required fields" });
    }

    // Prevent duplicate pending requests
    const existing = await pool.query(
      `SELECT id FROM driver_approvals
       WHERE order_id = $1
       AND driver_id = $2
       AND status = 'pending'`,
      [order_id, driver_id]
    );

    if (existing.rows.length > 0) {
      return res.status(400).json({
        message: "Approval already pending"
      });
    }

    // Get customer email
    const orderResult = await pool.query(
      `SELECT o.user_id, c.email
       FROM orders o
       JOIN customers c ON o.user_id = c.id
       WHERE o.id = $1`,
      [order_id]
    );

    if (!orderResult.rows.length) {
      return res.status(404).json({ message: "Order not found" });
    }

    const customer_id = orderResult.rows[0].user_id;
    const customer_email = orderResult.rows[0].email;

    const token = crypto.randomBytes(32).toString("hex");

    // Save approval
    await pool.query(
      `INSERT INTO driver_approvals
       (order_id, driver_id, customer_id, request_type, status, token, note, slot_start, slot_end)
       VALUES ($1,$2,$3,$4,'pending',$5,$6,$7,$8)`,
      [order_id, driver_id, customer_id, request_type, token, note || null, slot_start || null, slot_end || null]
    );

    const acceptLink =
      `https://api.impacgo.com/driver-approval/${token}/approved`;

    const declineLink =
      `https://api.impacgo.com/driver-approval/${token}/declined`;

    // Show the customer the actual proposed window, not just "an early/late
    // change" - without this they'd be asked to accept/decline blind.
    const slotSummary = (slot_start && slot_end)
      ? `${new Date(slot_start).toLocaleString('en-IN', { timeZone: 'UTC', day: 'numeric', month: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false })} - ${new Date(slot_end).toLocaleString('en-IN', { timeZone: 'UTC', hour: '2-digit', minute: '2-digit', hour12: false })}`
      : null;

    // Send professional email. Best-effort: the approval request itself is
    // already saved above, so a broken/misconfigured SMTP account (which
    // throws here) must not turn an otherwise-successful request into a
    // failure response - the driver would see "failed" even though the
    // request was created and is awaiting the customer's response.
    let emailSent = true;
    try {
    await transporter.sendMail({
      from: "ImpacGo <support@impacgo.com>",
      to: customer_email,
      subject: "Reschedule Approval Required",
      html: `
      <div style="background:#f4f6f8;padding:30px 10px;font-family:Arial,sans-serif;">
        <div style="max-width:500px;margin:auto;background:#ffffff;
                    padding:30px;border-radius:12px;
                    box-shadow:0 6px 20px rgba(0,0,0,0.08);">

          <h2 style="text-align:center;color:#006A6A;margin-bottom:10px;">
            ImpacGo
          </h2>

          <h3 style="color:#333;margin-top:0;">
            Pickup/Delivery Reschedule Request
          </h3>

          <p style="color:#555;font-size:14px;">
            Your driver has requested an
            <b>${request_type}</b> change for your order.
          </p>
          ${slotSummary ? `<p style="color:#333;font-size:14px;text-align:center;"><b>Proposed slot:</b> ${slotSummary}</p>` : ''}

          <div style="text-align:center;margin-top:25px;">
            <a href="${acceptLink}"
               style="display:inline-block;
                      background:#2e7d32;
                      color:#ffffff;
                      padding:12px 25px;
                      text-decoration:none;
                      border-radius:6px;
                      font-weight:bold;
                      margin-right:10px;">
              Accept
            </a>

            <a href="${declineLink}"
               style="display:inline-block;
                      background:#c62828;
                      color:#ffffff;
                      padding:12px 25px;
                      text-decoration:none;
                      border-radius:6px;
                      font-weight:bold;">
              Decline
            </a>
          </div>

          <p style="margin-top:30px;font-size:12px;color:#999;text-align:center;">
            © ${new Date().getFullYear()} ImpacGo
          </p>
        </div>
      </div>
      `
    });
    } catch (mailErr) {
      emailSent = false;
      console.warn("⚠️  Reschedule approval saved, but the email failed to send:", mailErr.message);
    }

    res.json({
      message: emailSent
        ? "Approval email sent successfully"
        : "Approval request saved, but the notification email could not be sent"
    });

  } catch (err) {
    console.error("Request approval error:", err);
    res.status(500).json({ message: "Server error" });
  }
});

app.get("/driver-approval/:token/:status", async (req, res) => {
  try {
    const { token, status } = req.params;

    if (!["approved", "declined"].includes(status)) {
      return res.send("Invalid response");
    }

    const result = await pool.query(
      `UPDATE driver_approvals
       SET status = $1, updated_at = CURRENT_TIMESTAMP
       WHERE token = $2 AND status = 'pending'
       RETURNING driver_id, order_id, request_type, slot_start, slot_end, note`,
      [status, token]
    );

    if (!result.rows.length) {
      return res.send("Invalid or expired link");
    }

    const { driver_id, order_id, request_type, slot_start, slot_end, note } = result.rows[0];

    // The whole point of a customer APPROVING a reschedule request is that
    // the order's actual pickup slot changes - without this, "approved"
    // requests silently did nothing to the order.
    if (status === "approved" && slot_start && slot_end) {
      const pad = (n) => n.toString().padStart(2, '0');
      const s = new Date(slot_start);
      const e = new Date(slot_end);
      // UTC getters, not local: slot_start/slot_end arrive as ISO strings whose
      // numbers are already the intended wall-clock slot (same convention the
      // Flutter apps use everywhere else, formatting these timestamps without
      // ever calling .toLocal()) - using local getters here would silently
      // shift the slot by the server's UTC offset (e.g. +5:30 in India).
      const formattedSlot = `${s.getUTCDate()}/${s.getUTCMonth() + 1}/${s.getUTCFullYear()}, ${pad(s.getUTCHours())}:${pad(s.getUTCMinutes())} - ${pad(e.getUTCHours())}:${pad(e.getUTCMinutes())}`;

      await pool.query(
        `UPDATE orders
         SET previous_collect_slot = collect_slot,
             collect_slot = $2,
             rescheduled_at = NOW(),
             reschedule_reason = $3
         WHERE id = $1`,
        [order_id, formattedSlot, note || `Driver-requested ${request_type} change`]
      );
    }

    await pool.query(
      `INSERT INTO driver_logs
       (driver_id, order_id, action)
       VALUES ($1,$2,$3)`,
      [
        driver_id,
        order_id,
        `Customer ${status} ${request_type} request`
      ]
    );

    res.send(`
    <!DOCTYPE html>
    <html>
    <head>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>ImpacGo</title>
      <style>
        body {
          margin:0;
          padding:0;
          background:#f4f6f8;
          font-family:Arial,sans-serif;
          display:flex;
          justify-content:center;
          align-items:center;
          height:100vh;
        }
        .card {
          background:#ffffff;
          padding:40px 30px;
          border-radius:12px;
          box-shadow:0 8px 25px rgba(0,0,0,0.1);
          text-align:center;
          width:90%;
