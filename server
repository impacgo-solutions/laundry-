      "Content-Type": row.mime_type || "video/mp4",
      "Content-Length": bytes.length,
      "Content-Disposition": `attachment; filename="${(row.file_name || "video.mp4").replace(/[^\w.\-]/g, "_")}"`,
    });
    res.end(bytes);
  } catch (err) {
    res.status(500).send("Server error");
  }
});

app.post("/get-presigned-url", async (req, res) => {
  try {
    // Different callers use different key names for the same two fields
    // (lsp's video uploader sends file_name only; the admin app's profile-
    // image uploaders send file_name/content_type or filename/contentType).
    // ContentType used to be hardcoded to video/mp4 for every caller, which
    // silently broke image uploads with an S3 signature mismatch (signed as
    // video/mp4, sent as image/jpeg) - default kept for the original
    // video caller that never sends a content type.
    const file_name = req.body.file_name || req.body.filename;
    const contentType = req.body.content_type || req.body.contentType || "video/mp4";

    if (!file_name) {
      return res.status(400).json({ error: "file_name is required" });
    }

    const command = new PutObjectCommand({
      Bucket: "laundary-videos",   // <-- MUST MATCH S3 BUCKET EXACTLY
      Key: file_name,
      ContentType: contentType,
    });

    const uploadUrl = await getSignedUrl(s3, command, { expiresIn: 300 });

    return res.json({
      uploadUrl,
      fileUrl: `https://laundary-videos.s3.amazonaws.com/${file_name}`,
    });

  } catch (err) {
    console.error("Presigned URL Error:", err);
    res.status(500).json({ error: err.message });
  }
});
