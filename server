app.get('/api/orders/new', async (req, res) => {
  try {
    const { managerId } = req.query;
    
    const query = `
      SELECT
        o.id AS order_id,
        c.name AS customer_name,
        a.full_address,
        a.postcode,
        o.collect_slot AS pickup_slot,
        o.delivery_slot,
        COALESCE(SUM(oi.quantity), 0) AS total_items_quantity,
        o.manager_id
      FROM orders o
      JOIN customers c ON o.user_id = c.id
      JOIN addresses a ON o.address_id = a.address_id
      LEFT JOIN order_items oi ON o.id = oi.order_id
      WHERE o.status = 'NEW'
      AND (
        -- Show orders that are assigned to this specific manager
        o.manager_id = $1
        -- OR show orders that have no manager assigned yet
        OR o.manager_id IS NULL
      )
      GROUP BY o.id, c.name, a.full_address, a.postcode, o.collect_slot, o.delivery_slot, o.manager_id
      ORDER BY o.created_at DESC;
    `;
    
    const { rows } = await pool.query(query, [managerId]);
    res.json(rows);
  } catch (error) {
    console.error('Error fetching new orders:', error);
    res.status(500).json({ error: 'Internal Server Error' });
  }
});
