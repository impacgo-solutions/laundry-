async function getTopAreasByOrders(pool, limit = 10, days = null) {
  const dateFilter = days
    ? `AND o.created_at >= NOW() - INTERVAL '${days} days'`
    : '';

  const result = await pool.query(`
    SELECT 
      area_code,
      area_name,
      total_orders,
      ROUND(total_orders * 100.0 / SUM(total_orders) OVER (), 1) AS percentage
    FROM (
      SELECT 
        COALESCE(a.postcode, a.pincode, 'Unknown') AS area_code,
        COALESCE(a.street_name, a.full_address, 'Unknown') AS area_name,
        COUNT(o.id) AS total_orders
      FROM public.orders o
      JOIN public.addresses a ON a.address_id = o.address_id
      WHERE (a.postcode IS NOT NULL OR a.pincode IS NOT NULL)
      ${dateFilter}
      GROUP BY 
        COALESCE(a.postcode, a.pincode, 'Unknown'),
        COALESCE(a.street_name, a.full_address, 'Unknown')
    ) sub
    ORDER BY total_orders DESC
    LIMIT $1
  `, [limit]);

  return result.rows;
}

