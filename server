app.post("/driver-notes", async (req, res) => {
  try {
    const {
      order_id,
      driver_id,
      notes = "",
      ib_bags = 0,
      non_ib_bags = 0
    } = req.body;

    if (!order_id || !driver_id) {
      return res.status(400).json({
        error: "order_id and driver_id are required."
      });
    }

   const query = `
  INSERT INTO driver_notes
    (order_id, driver_id, notes, ib_bags, non_ib_bags)
  VALUES
    (
      $1,
      $2,
      COALESCE(NULLIF($3, ''), 'Bag count recorded during pickup'),
      $4,
      $5
    )

  ON CONFLICT (order_id, driver_id)


  DO UPDATE SET
    notes = CASE

      -- If empty → keep old
      WHEN EXCLUDED.notes = '' THEN driver_notes.notes

      -- If default → keep old if exists
      WHEN EXCLUDED.notes = 'Bag count recorded during pickup'
           AND driver_notes.notes IS NOT NULL
      THEN driver_notes.notes

      -- Else overwrite
      ELSE EXCLUDED.notes
    END,

    ib_bags = EXCLUDED.ib_bags,
    non_ib_bags = EXCLUDED.non_ib_bags,
    created_at = NOW()

  RETURNING *;
`;

    const { rows } = await pool.query(query, [
      order_id,
      driver_id,
      notes,
      ib_bags,
      non_ib_bags
    ]);

    res.status(200).json({
      success: true,
      message: "Driver note saved/updated",
      data: rows[0],
    });

  } catch (err) {
    console.error("❌ Driver notes error:", err);

    res.status(500).json({
      success: false,
      error: err.message,
    });
  }
});

