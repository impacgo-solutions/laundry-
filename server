// A discount_percent over 100 makes an order's total negative (the business
// pays the customer); negative min_amount/order_limit are nonsensical. None
// of this was ever validated server-side, so a typo here is a live financial
// risk, not just bad data.
function validateDiscountFields({ min_amount, discount_percent, order_limit }) {
  if (discount_percent === undefined || discount_percent === null || discount_percent < 0 || discount_percent > 100) {
    return "discount_percent must be between 0 and 100";
  }
  if (min_amount !== undefined && min_amount !== null && min_amount < 0) {
    return "min_amount cannot be negative";
  }
  if (order_limit !== undefined && order_limit !== null && order_limit < 0) {
    return "order_limit cannot be negative";
  }
  return null;
}

app.post("/api/admin/discounts", authenticateAdmin, async (req, res) => {
