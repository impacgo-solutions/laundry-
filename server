    // Picking up an order is the one moment that must leave an audit trail:
    // who picked it up and when. Without this, "Today's History"/performance
    // reports have no way to attribute or time a pickup at all.
    const isPickup = statusbar.toLowerCase() === "picked";

    const query = `
      UPDATE orders
      SET statusbar = $1,
          driver_id = COALESCE($3, driver_id),
          picked_time = CASE WHEN $4 THEN NOW() ELSE picked_time END
      WHERE id = $2
      RETURNING *;
    `;

    console.log("🔧 Executing Query:", query, [statusbar, orderId, driver_id, isPickup]);

    const dbRes = await pool.query(query, [statusbar, orderId, driver_id || null, isPickup]);

    if (dbRes.rows.length === 0) {
      console.log("❌ Order Not Found:", orderId);
      return res.status(404).json({ error: "Order not found" });
    }

    console.log("✅ Update Successful:", dbRes.rows[0]);

    res.json({ success: true, updatedOrder: dbRes.rows[0] });

  } catch (err) {
    console.error("❌ Server Error:", err);
    res.status(500).json({ error: err.message });
  }
});

// Soft-cancel an order (used by the driver/manager app's "Cancel Order"
// button). This must never hard-delete the row - unlike /admin/orders/:orderId
// (an intentional admin-only permanent-delete tool), cancelling an order from
// the field is a routine, frequent action and has to preserve the order for
// history/audit/analytics (cancelled_orders reporting already assumes this
// status exists - see status docs above). Already-delivered or
// already-cancelled orders can't be re-cancelled.
app.post("/api/orders/cancel", authenticateDriverOrManager, async (req, res) => {
  try {
    const { orderId } = req.body;
    if (!orderId) {
      return res.status(400).json({ success: false, message: "Missing orderId" });
    }

    const current = await pool.query("SELECT status FROM orders WHERE id = $1", [orderId]);
    if (current.rows.length === 0) {
      return res.status(404).json({ success: false, message: "Order not found" });
    }
    const currentStatus = (current.rows[0].status || "").toUpperCase();
    if (currentStatus === "DELIVERED") {
      return res.status(400).json({ success: false, message: "Cannot cancel an order that has already been delivered" });
    }
    if (currentStatus === "CANCELLED") {
      return res.status(400).json({ success: false, message: "Order is already cancelled" });
    }

    const dbRes = await pool.query(
      "UPDATE orders SET status = 'CANCELLED' WHERE id = $1 RETURNING *",
      [orderId]
    );

    res.json({ success: true, message: "Order cancelled successfully", updatedOrder: dbRes.rows[0] });
  } catch (err) {
    console.error("❌ Cancel Order Error:", err);
    res.status(500).json({ success: false, message: "Server error" });
  }
});

