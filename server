async function autoChargeInvoice(invoice_id) {
  try {
    const invRes = await pool.query(
      "SELECT customer_id,total_amount,status FROM invoice WHERE invoice_id=$1",
      [invoice_id]
    );

    if (!invRes.rows.length) {
      return { success: false, error: "Invoice not found" };
    }

    const invoice = invRes.rows[0];

    if (invoice.status === "paid") {
      return { success: false, error: "Invoice already paid" };
    }

    const amount = Math.round(Number(invoice.total_amount) * 100);

    const custRes = await pool.query(
      "SELECT stripe_customer_id FROM customers WHERE id=$1",
      [invoice.customer_id]
    );

    const stripeCustomerId = custRes.rows[0]?.stripe_customer_id;

    if (!stripeCustomerId) {
      return { success: false, error: "Stripe customer missing" };
    }

    const stripeCustomer = await stripe.customers.retrieve(stripeCustomerId);

    let paymentMethodId =
      stripeCustomer.invoice_settings?.default_payment_method;

    if (!paymentMethodId) {
      const methods = await stripe.paymentMethods.list({
        customer: stripeCustomerId,
        type: "card",
      });

      if (!methods.data.length) {
        return { success: false, error: "No saved cards found" };
      }

      paymentMethodId = methods.data[0].id;
    }

    const pi = await stripe.paymentIntents.create(
      {
        amount,
        currency: "inr",
        customer: stripeCustomerId,
        payment_method: paymentMethodId,
        off_session: true,
        confirm: true,
        payment_method_types: ["card"],

        metadata: {
          invoice_id: invoice_id,
          system: "impacgo",
        },
      },
      {
        idempotencyKey: `auto_charge_${invoice_id}`,
      }
    );

    const invoiceStatus = pi.status === "succeeded" ? "paid" : "unpaid";

    await pool.query(
      `UPDATE invoice
       SET stripe_payment_intent_id=$1,
           status=$2,
           payment_method='card'
       WHERE invoice_id=$3`,
      [pi.id, invoiceStatus, invoice_id]
    );

    return { success: true, status: pi.status };
  } catch (err) {
    console.error("AUTO CHARGE ERROR:", err);
    return { success: false, error: err.message };
  }
}





