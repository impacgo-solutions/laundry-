app.post(
  "/approvalrequest",
  authenticateManager, // 🔐 REQUIRED
  async (req, res) => {
    try {
      const {
        order_id,
        note,
        image_name,
        image_base64,
        type,
        requested_time,
        amount,
      } = req.body;

      const managerId = req.user.id; // 🔥 FROM JWT

      if (!order_id || !type) {
        return res.status(400).json({
          success: false,
          error: "order_id and type are required",
        });
      }

      let query, values;

      // 💰 PRICE APPROVAL
      if (type === "price") {
        if (!note) {
          return res.status(400).json({
            success: false,
            error: "note is required for price approval",
          });
        }

        // Without a stored numeric amount, approving this later has nothing
        // to actually add to the order's total - the note is free text only.
        // Must also be strictly positive: the frontend already enforces this,
        // but a negative amount here would silently REDUCE the customer's
        // total if approved (total = total + amount), and zero is meaningless
        // for a request whose whole point is an additional charge.
        if (amount === undefined || amount === null || isNaN(parseFloat(amount)) || parseFloat(amount) <= 0) {
          return res.status(400).json({
            success: false,
            error: "A positive numeric amount is required for price approval",
          });
        }

        query = `
          INSERT INTO approval_requests
          (order_id, note, status, created_at, type, manager_id, amount)
          VALUES ($1, $2, 'pending', NOW(), 'price', $3, $4)
          RETURNING *;
        `;
        values = [order_id, note, managerId, parseFloat(amount)];
      }

      // ⏱ TIME APPROVAL
      else if (type === "time") {
        if (!requested_time) {
          return res.status(400).json({
            success: false,
            error: "requested_time is required for time approval",
          });
        }

        query = `
          INSERT INTO approval_requests
          (order_id, note, requested_time, status, created_at, type, manager_id)
          VALUES ($1, $2, $3, 'pending', NOW(), 'time', $4)
          RETURNING *;
        `;
        values = [
          order_id,
          note || `Manager requested extra time: ${requested_time} minutes`,
          requested_time,
          managerId,
        ];
      }

      // 🔄 DAMAGE APPROVAL
      else if (type === "damage") {
        if (!note || !image_name || !image_base64) {
          return res.status(400).json({
            success: false,
            error:
              "note, image_name and image_base64 are required for damage approval",
          });
        }

        query = `
          INSERT INTO approval_requests
          (order_id, note, image_name, image_base64, status, created_at, type, manager_id)
          VALUES ($1, $2, $3, $4, 'pending', NOW(), 'damage', $5)
          RETURNING *;
        `;
        values = [order_id, note, image_name, image_base64, managerId];
      }

      else {
        return res.status(400).json({
          success: false,
          error: "Invalid approval type",
        });
      }

      const result = await pool.query(query, values);

      res.status(201).json({
        success: true,
        message: "Approval request created successfully",
        data: result.rows[0],
      });
    } catch (error) {
      console.error("❌ Error creating approval request:", error);
      res.status(500).json({
        success: false,
        error: "Failed to create approval request",
      });
    }
  }
);


