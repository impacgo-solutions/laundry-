app.post("/check-service", async (req, res) => {
  const { error, value } = coordsSchema.validate(req.body);
  if (error) return res.status(400).json({ error: error.message });

  const { latitude, longitude } = value;
  try {
    // ✅ Check if inside any service area (within radius)
    const insideSql = `
      SELECT id, name,
             ST_Distance(
               location,
               ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography
             ) AS meters,
             radius_km
      FROM branches
      WHERE ST_DWithin(
        location,
        ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography,
        radius_km * 1000
      )
      ORDER BY meters ASC
      LIMIT 1;
    `;

    const { rows } = await pool.query(insideSql, [longitude, latitude]);

    if (rows.length) {
      const r = rows[0];
      return res.json({
        success: true,
        area: r.name,
        distance_km: +(r.meters / 1000).toFixed(2),
        within_radius_km: r.radius_km,
      });
    }

    // ❌ Outside all radii — find nearest branch
    const nearestSql = `
      SELECT id, name,
             ST_Distance(
               location,
               ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography
             ) AS meters,
             radius_km
      FROM branches
      ORDER BY meters ASC
      LIMIT 1;
    `;

    const nearest = await pool.query(nearestSql, [longitude, latitude]);
    const n = nearest.rows[0];

    return res.json({
      success: false,
      message: "No service available at your area",
      nearest_branch: n
        ? {
            name: n.name,
            distance_km: +(n.meters / 1000).toFixed(2),
            radius_km: n.radius_km,
          }
        : null,
    });
  } catch (err) {
    console.error("Error:", err);
    res.status(500).json({ error: "Server error" });
  }
});
