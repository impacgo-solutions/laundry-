// A cache is never allowed to block the response it's supposed to speed up -
// isOpen can read true while the socket is mid-reconnect, so bound every
// Redis call with a short timeout and swallow any failure.
function redisWithTimeout(promise, timeoutMs = 300) {
  return Promise.race([
    promise,
    new Promise((_, reject) => setTimeout(() => reject(new Error('redis timeout')), timeoutMs)),
  ]).catch(() => null);
}

app.get('/orders', authenticate, async (req, res) => {
  const userId = req.user.id;
  const limit = parseInt(req.query.limit || "10");
  const cursor = req.query.cursor; // ISO timestamp

  const cacheKey = `orders:${userId}:cursor:${cursor || "first"}:limit:${limit}`;

  try {
    // 1️⃣ Redis cache check (skip if Redis isn't connected - never let caching
    // block the actual DB-backed response)
    if (redisClient.isOpen) {
      const cached = await redisWithTimeout(redisClient.get(cacheKey));
      if (cached) {
        return res.json(JSON.parse(cached));
      }
    }

    const client = await pool.connect();
    try {
      // 2️⃣ Cursor condition
      const cursorCondition = cursor
        ? `AND o.created_at < $2`
        : "";

      const params = cursor
        ? [userId, cursor, limit + 1]
        : [userId, limit + 1];

      // 3️⃣ Fetch orders
      const ordersQuery = `
        SELECT
          o.id AS order_id,
          o.subtotal,
          o.tip,
          o.total,
          o.status,
          o.statusbar,
          o.created_at,
          EXISTS (
            SELECT 1 FROM approval_requests ar WHERE ar.order_id = o.id
          ) AS has_approval_request
        FROM orders o
        WHERE o.user_id = $1
        ${cursorCondition}
        ORDER BY o.created_at DESC
        LIMIT $${params.length};
      `;

      const ordersResult = await client.query(ordersQuery, params);

      let orders = ordersResult.rows;
      const hasMore = orders.length > limit;

      if (hasMore) orders.pop(); // remove extra record

      // 4️⃣ Fetch items
      const orderIds = orders.map(o => o.order_id);

      let itemsByOrder = {};
      if (orderIds.length > 0) {
        const itemsResult = await client.query(`
          SELECT
            oi.order_id,
            oi.product_id,
            p.name AS product_name,
            oi.quantity,
            oi.price_at_purchase
          FROM order_items oi
          JOIN products p ON oi.product_id = p.id
          WHERE oi.order_id = ANY($1)
        `, [orderIds]);

        for (const item of itemsResult.rows) {
          if (!itemsByOrder[item.order_id]) {
            itemsByOrder[item.order_id] = [];
          }
          itemsByOrder[item.order_id].push(item);
        }
      }

      // 5️⃣ Final response
      const response = {
        orders: orders.map(o => ({
          ...o,
          items: itemsByOrder[o.order_id] || []
        })),
        nextCursor: orders.length
          ? orders[orders.length - 1].created_at
          : null,
        hasMore
      };

      // 6️⃣ Cache (short TTL) - best-effort, never blocks the response
      if (redisClient.isOpen) {
        await redisWithTimeout(redisClient.setEx(cacheKey, 60, JSON.stringify(response)));
      }

      res.json(response);

    } finally {
      client.release();
    }

  } catch (err) {
    console.error("❌ Cursor orders error:", err);
    res.status(500).json({ error: "Failed to fetch orders" });
  }
});


