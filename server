app.get("/stats/today/driver/:driverId", async (req, res) => {
  try {
    const { driverId } = req.params;
    console.log(`Fetching stats for driver: ${driverId}`);

    // Get today's date range
    const startOfDay = new Date();
    startOfDay.setHours(0, 0, 0, 0);
    
    const endOfDay = new Date();
    endOfDay.setHours(23, 59, 59, 999);

    // First, get the manager_id associated with this driver
    const driverQuery = await pool.query(
      `SELECT manager_id, name FROM driver WHERE driver_id = $1`,
      [driverId]
    );

    if (driverQuery.rows.length === 0) {
      return res.status(404).json({ error: "Driver not found" });
    }

    const managerId = driverQuery.rows[0].manager_id;
    const driverName = driverQuery.rows[0].name;

    if (!managerId) {
      return res.status(400).json({ 
        error: "Driver is not assigned to any manager",
        driver_id: driverId,
        driver_name: driverName
      });
    }

    // Get all orders for today for this manager
    const ordersQuery = await pool.query(
      `SELECT 
        id, 
        statusbar,
        picked_time, 
        delivery_time,
        dropped_time,
        created_at
       FROM orders 
       WHERE manager_id = $1 
       AND created_at BETWEEN $2 AND $3
       ORDER BY created_at DESC`,
      [managerId, startOfDay, endOfDay]
    );

    const orders = ordersQuery.rows;
    console.log(`Found ${orders.length} orders for manager ${managerId}`);

    // Calculate statistics based on statusbar
    const statusbarCounts = {};
    orders.forEach(order => {
      const status = order.statusbar || 'UNKNOWN';
      statusbarCounts[status] = (statusbarCounts[status] || 0) + 1;
    });

    // Define what each statusbar value means
    const NEW_STATUSES = ['NEW', 'PENDING', 'CONFIRMED'];
    const PICKED_STATUSES = ['PICKED', 'IN_PROGRESS', 'PROCESSING'];
    const DELIVERED_STATUSES = ['DELIVERED', 'COMPLETED'];
    const DROPPED_STATUSES = ['DROPPED'];

    // Calculate counts
    const picked = orders.filter(o => PICKED_STATUSES.includes(o.statusbar)).length;
    const delivered = orders.filter(o => DELIVERED_STATUSES.includes(o.statusbar)).length;
    const dropped = orders.filter(o => DROPPED_STATUSES.includes(o.statusbar)).length;
    const completed = delivered + dropped;
    const toBePicked = orders.filter(o => NEW_STATUSES.includes(o.statusbar)).length;
    const toBeDelivered = orders.filter(o => 
      PICKED_STATUSES.includes(o.statusbar) && 
      !DELIVERED_STATUSES.includes(o.statusbar) && 
      !DROPPED_STATUSES.includes(o.statusbar)
    ).length;

    const response = {
      success: true,
      date: new Date().toISOString().split('T')[0],
      driver: {
        id: driverId,
        name: driverName,
        manager_id: managerId
      },
      statistics: {
        total_orders: orders.length,
        picked,
        delivered,
        dropped,
        completed,
        to_be_picked: toBePicked,
        to_be_delivered: toBeDelivered
      },
      statusbar_breakdown: statusbarCounts,
      orders_count: orders.length
    };

    console.log(`Sending response for driver ${driverId}:`, response.statistics);
    res.json(response);

  } catch (err) {
    console.error("Error fetching driver stats:", err);
    res.status(500).json({ 
      success: false,
      error: err.message 
    });
  }
});
