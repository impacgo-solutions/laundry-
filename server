app.get("/admin/managerReportSimple", async (req, res) => {
  try {
    const { fromDate, toDate } = req.query;

    if (!fromDate || !toDate) {
      return res.status(400).json({ 
        error: "Both fromDate and toDate parameters are required" 
      });
    }

    const query = `
      SELECT 
        COALESCE(lm.name, 'Unassigned') AS manager_name,
        o.manager_id,
        o.id AS order_id,
        c.name AS customer_name,
        COUNT(oi.order_item_id) AS number_of_items,
        o.total AS order_amount,
        o.created_at AS order_date,
        o.statusbar AS order_status
      FROM orders o
      LEFT JOIN laundrymanager lm ON o.manager_id = lm.user_id
      LEFT JOIN customers c ON o.user_id = c.id
      LEFT JOIN order_items oi ON o.id = oi.order_id
      WHERE o.created_at >= $1::timestamp 
        AND o.created_at <= $2::timestamp + INTERVAL '1 day'
      GROUP BY o.id, o.total, o.created_at, o.manager_id, lm.name, c.name, o.statusbar
      ORDER BY manager_name, o.created_at DESC
    `;

    const result = await pool.query(query, [fromDate, toDate]);

    // Calculate totals
    const managerTotals = {};
    let grandTotal = 0;

    result.rows.forEach(order => {
      const managerName = order.manager_name;
      
      if (!managerTotals[managerName]) {
        managerTotals[managerName] = {
          totalAmount: 0,
          totalOrders: 0,
          totalItems: 0
        };
      }

      managerTotals[managerName].totalAmount += parseFloat(order.order_amount);
      managerTotals[managerName].totalOrders += 1;
      managerTotals[managerName].totalItems += parseInt(order.number_of_items);
      
      grandTotal += parseFloat(order.order_amount);
    });

    // Calculate percentages
    Object.keys(managerTotals).forEach(managerName => {
      managerTotals[managerName].percentage = 
        ((managerTotals[managerName].totalAmount / grandTotal) * 100).toFixed(2);
    });

    res.json({
      success: true,
      reportPeriod: { fromDate, toDate },
      summary: {
        grandTotal: grandTotal,
        totalOrders: result.rows.length,
        managerBreakdown: managerTotals
      },
      orders: result.rows.map(row => ({
        orderId: row.order_id,
        managerName: row.manager_name,
        customerName: row.customer_name,
        numberOfItems: parseInt(row.number_of_items),
        orderAmount: parseFloat(row.order_amount),
        orderDate: row.order_date,
        orderStatus: row.order_status // Added statusbar field
      }))
    });

  } catch (error) {
    console.error("Error generating manager report:", error);
    res.status(500).json({ 
      success: false,
      error: "Failed to generate manager report" 
    });
  }
});
app.get("/admin/managerDetailedReport", async (req, res) => {
  try {
    const { managerId, fromDate, toDate } = req.query;

    if (!managerId || !fromDate || !toDate) {
      return res.status(400).json({ 
        success: false,
        error: "Manager ID, fromDate and toDate parameters are required" 
      });
    }

    // Get manager details
    const managerQuery = `SELECT * FROM laundrymanager WHERE user_id = $1`;
    const managerResult = await pool.query(managerQuery, [managerId]);
    
    if (managerResult.rows.length === 0) {
      return res.status(404).json({ 
        success: false,
        error: "Manager not found" 
      });
    }

    const manager = managerResult.rows[0];

    // Get orders for this manager with customer details
    const ordersQuery = `
      SELECT 
        o.id AS order_id,
        c.id AS customer_id,
        c.name AS customer_name,
        c.email AS customer_email,
        c.phone AS customer_phone,
        COUNT(oi.order_item_id) AS number_of_items,
        o.total AS order_amount,
        o.created_at AS order_date,
        ROW_NUMBER() OVER (ORDER BY o.created_at) as order_sequence
      FROM orders o
      LEFT JOIN customers c ON o.user_id = c.id
      LEFT JOIN order_items oi ON o.id = oi.order_id
      WHERE o.manager_id = $1
        AND o.created_at >= $2::timestamp 
        AND o.created_at <= $3::timestamp + INTERVAL '1 day'
      GROUP BY o.id, o.total, o.created_at, c.id, c.name, c.email, c.phone
      ORDER BY o.created_at ASC
    `;

    const ordersResult = await pool.query(ordersQuery, [managerId, fromDate, toDate]);
    const orders = ordersResult.rows;

    // Calculate commission based on order sequence
    let totalCommission = 0;
    let totalOrderAmount = 0;
    
    const ordersWithCommission = orders.map((order, index) => {
      let commissionRate;
      if (index === 0) {
        commissionRate = 0.25; // First order: 25%
      } else if (index === 1) {
        commissionRate = 0.20; // Second order: 20%
      } else {
        commissionRate = 0.15; // Subsequent orders: 15%
      }

      const orderAmount = parseFloat(order.order_amount);
      const commission = orderAmount * commissionRate;
      
      totalCommission += commission;
      totalOrderAmount += orderAmount;

      return {
        ...order,
        orderSequence: index + 1,
        commissionRate: (commissionRate * 100).toFixed(0) + '%',
        commissionAmount: parseFloat(commission.toFixed(2)),
        orderAmount: orderAmount
      };
    });

    // Get customer summary
    const customerSummary = {};
    ordersWithCommission.forEach(order => {
      const customerId = order.customer_id;
      if (!customerSummary[customerId]) {
        customerSummary[customerId] = {
          customerId: customerId,
          customerName: order.customer_name,
          customerEmail: order.customer_email,
          customerPhone: order.customer_phone,
          totalOrders: 0,
          totalAmount: 0,
          totalCommission: 0,
          orders: []
        };
      }
      
      customerSummary[customerId].totalOrders += 1;
      customerSummary[customerId].totalAmount += order.orderAmount;
      customerSummary[customerId].totalCommission += order.commissionAmount;
      customerSummary[customerId].orders.push({
        orderId: order.order_id,
        orderAmount: order.orderAmount,
        commissionAmount: order.commissionAmount,
        orderDate: order.order_date
      });
    });

    res.json({
      success: true,
      reportPeriod: { fromDate, toDate },
      manager: {
        id: manager.user_id,
        name: manager.name,
        username: manager.username,
        laundryServiceName: manager.laundryservicename
      },
      summary: {
        totalOrders: orders.length,
        totalOrderAmount: parseFloat(totalOrderAmount.toFixed(2)),
        totalCommission: parseFloat(totalCommission.toFixed(2)),
        averageCommission: orders.length > 0 ? parseFloat((totalCommission / orders.length).toFixed(2)) : 0
      },
      commissionStructure: {
        firstOrder: "25%",
        secondOrder: "20%", 
        subsequentOrders: "15%"
      },
      customerSummary: Object.values(customerSummary),
      orderDetails: ordersWithCommission
    });

  } catch (error) {
    console.error("Error generating manager detailed report:", error);
    res.status(500).json({ 
      success: false,
      error: "Failed to generate manager detailed report" 
    });
  }
});

