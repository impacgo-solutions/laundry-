// ---------------------------------------------------------------------
// Local media storage (replaces AWS S3 for profile photos and QC videos).
// Files are stored as bytea directly in Postgres and served back from
// here - the AWS access key that /get-presigned-url below relies on is
// dead in this environment, so nothing that depended on it ever actually
// reached S3. These endpoints need no external credentials at all.
// ---------------------------------------------------------------------
function serveMedia(bytes, mimeType, req, res) {
  if (!bytes) {
    return res.status(404).send("Not found");
  }
  const buf = Buffer.isBuffer(bytes) ? bytes : Buffer.from(bytes);
  const type = mimeType || "application/octet-stream";
  const range = req.headers.range;
  if (range) {
    const match = /bytes=(\d+)-(\d*)/.exec(range);
    const start = match ? parseInt(match[1], 10) : 0;
    const end = match && match[2] ? parseInt(match[2], 10) : buf.length - 1;
    res.status(206);
    res.set({
      "Content-Range": `bytes ${start}-${end}/${buf.length}`,
      "Accept-Ranges": "bytes",
      "Content-Length": end - start + 1,
      "Content-Type": type,
    });
    return res.end(buf.subarray(start, end + 1));
  }
  res.set({ "Content-Type": type, "Content-Length": buf.length, "Accept-Ranges": "bytes" });
  return res.end(buf);
}

