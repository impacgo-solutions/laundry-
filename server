      console.log(`⚠️ No specific manager found for approval, fetching any active manager`);
      
      const query2 = `
        SELECT fcm_token, user_id as manager_id, name, username
        FROM public.laundrymanager 
        WHERE fcm_token IS NOT NULL 
        LIMIT 1;
      `;

      result = await pool.query(query2);
    }

    if (result.rows.length === 0) {
      console.log(`❌ No manager with FCM token found`);
      return res.status(404).json({ 
        success: false, 
        error: "No manager with FCM token found" 
      });
