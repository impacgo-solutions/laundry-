app.post("/api/app-settings", async (req, res) => {

  try {

    const { key, value, description } = req.body;

    // Validate required fields

    if (!key || !value) {

      return res.status(400).json({

        success: false,

        message: "Key and value are required"

      });

    }
 
    // Check if key already exists (since key is primary key)

    const checkQuery = 'SELECT * FROM app_settings WHERE key = $1';

    const checkResult = await pool.query(checkQuery, [key]);

    if (checkResult.rows.length > 0) {

      return res.status(409).json({

        success: false,

        message: "Setting key already exists"

      });

    }
 
    // Insert new setting - only using columns that exist in your table

    // Note: removed created_at as it doesn't exist in your table

    const insertQuery = `

      INSERT INTO app_settings (key, value, description, updated_at)

      VALUES ($1, $2, $3, NOW())

      RETURNING *

    `;

    const result = await pool.query(insertQuery, [

      key,

      value,

      description || null

    ]);
 
    res.status(201).json({

      success: true,

      message: "Setting created successfully",

      data: result.rows[0]

    });
 
  } catch (error) {
    console.error("Create App Setting Error:", error);
    // Handle unique violation (though we already checked, just in case)
    if (error.code === "23505") {
      return res.status(409).json({
        success: false,
        message: "Setting key already exists"
      });
    }
    res.status(500).json({
      success: false,
      message: "Failed to create setting",
      error: error.message
    });
  }
});

