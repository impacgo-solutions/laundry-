app.get('/user/referral-code', authenticate, async (req, res) => {
  try {
    const result = await pool.query(
      'SELECT referral_code FROM customers WHERE id = $1',
      [req.user.id]
    );

    let code = result.rows[0].referral_code;

    // No signup path ever assigns a referral_code, so every customer would
    // otherwise have nothing to share here - generate one lazily on first
    // fetch instead.
    if (!code) {
      const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no 0/O/1/I
      for (let attempt = 0; attempt < 5 && !code; attempt++) {
        const candidate = Array.from({ length: 6 }, () => alphabet[Math.floor(Math.random() * alphabet.length)]).join('');
        const clash = await pool.query('SELECT 1 FROM customers WHERE referral_code = $1', [candidate]);
        if (clash.rows.length === 0) code = candidate;
      }
      if (code) {
        await pool.query('UPDATE customers SET referral_code = $1 WHERE id = $2', [code, req.user.id]);
      }
    }

    return res.json({
      success: true,
      referral_code: code
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ success: false, message: 'Server error' });
  }
});
