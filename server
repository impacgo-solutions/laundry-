app.post("/api/send-notification", async (req, res) => {
  try {
    const { target_token, title, body, data = {} } = req.body;

    if (!target_token || !title || !body) {
      return res.status(400).json({
        success: false,
        error: "target_token, title, and body are required",
      });
    }

    const message = {
      token: target_token,

      notification: {
        title,
        body,
      },

      data: Object.fromEntries(
        Object.entries(data).map(([k, v]) => [k, String(v)])
      ),

      android: {
        priority: "high",
        ttl: 60 * 60 * 1000, // 1 hour
        notification: {
          sound: "default",
          channelId: "approval_channel",
        },
      },

      apns: {
        headers: {
          "apns-priority": "10",
        },
        payload: {
          aps: {
            alert: {
              title,
              body,
            },
            sound: "default",
            badge: 1,
            "content-available": 1,
          },
        },
      },
    };

    const messageId = await customerMessaging.send(message);

    // Log notification
    await pool.query(
      `
      INSERT INTO notification_logs (target_token, title, body, data, message_id)
      VALUES ($1, $2, $3, $4, $5)
      `,
      [target_token, title, body, JSON.stringify(data), messageId]
    );

    res.json({
      success: true,
      message: "Notification sent",
      message_id: messageId,
    });

  } catch (error) {
    console.error("❌ FCM SEND ERROR:", error);

    let status = 500;
    let msg = "Failed to send notification";

    if (error.code === "messaging/registration-token-not-registered") {
      status = 410;
      msg = "FCM token expired or invalid";
    }

    res.status(status).json({
      success: false,
      error: msg,
      details: error.message,
    });
  }
});
