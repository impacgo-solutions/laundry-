app.put('/admin/invoice/:order_id', async (req, res) => {
  const { order_id } = req.params;
  const {
    service_fee,
    tax,
    delivery_fee,
    driver_tip,
    status,
    payment_link,
    order_items
  } = req.body;

  const client = await pool.connect();

  try {
    await client.query("BEGIN");

    // ✅ Update ONLY allowed invoice fields (NO totals)
    await client.query(`
      UPDATE invoice
      SET
        service_fee = COALESCE($1, service_fee),
        tax = COALESCE($2, tax),
        delivery_fee = COALESCE($3, delivery_fee),
        driver_tip = COALESCE($4, driver_tip),
        status = COALESCE($5, status),
        payment_link = COALESCE($6, payment_link)
      WHERE order_id = $7
    `, [
      service_fee,
      tax,
      delivery_fee,
      driver_tip,
      status,
      payment_link,
      order_id
    ]);

    // ✅ Update order items ONLY
    if (Array.isArray(order_items)) {
      for (const item of order_items) {
        await client.query(`
          UPDATE order_items
          SET
            quantity = COALESCE($1, quantity),
            price_at_purchase = COALESCE($2, price_at_purchase),
            post_pass = COALESCE($3, post_pass),
            pass = COALESCE($4, pass)
          WHERE order_item_id = $5
            AND order_id = $6
        `, [
          item.quantity,
          item.price_at_purchase,
          item.post_pass,
          item.pass,
          item.order_item_id,
          order_id
        ]);
      }
    }

    await client.query("COMMIT");

    return res.json({
      success: true,
      message: "Invoice updated successfully (totals unchanged)"
    });

  } catch (error) {
    await client.query("ROLLBACK");
    console.error("Error updating invoice:", error);
    return res.status(500).json({
      success: false,
      error: "Internal server error"
    });
  } finally {
    client.release();
  }
});
