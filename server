app.post('/quick-booking', async (req, res) => {
  const client = await pool.connect();
  try {
    const {
  name,
  email,
  phone,
  house_number,
  street_name,
  full_address,
  postcode,
  latitude,
  longitude,
  collect_slot,
  delivery_slot,
  notes,
  images = []
} = req.body;

  
    if (!name || !phone || !collect_slot || !delivery_slot) {
      return res.status(400).json({
        success: false,
        message: 'Missing required fields'
      });
    }

    await client.query('BEGIN');

    // 1️⃣ FIND OR CREATE CUSTOMER
    let userResult = await client.query(
      `SELECT * FROM customers WHERE email = $1 OR phone = $2`,
      [email, phone]
    );

    let user;
    let isFirstOrder = false;
    let stripeCustomerId = null;

    if (userResult.rows.length > 0) {
      user = userResult.rows[0];
      stripeCustomerId = user.stripe_customer_id;
    } else {
      // Create Stripe customer for new user
      const stripeCustomer = await stripe.customers.create({
        email: email,
        name: name,
        phone: phone,
        metadata: {
          source: 'quick_booking'
        }
      });

      const insertUser = await client.query(
        `INSERT INTO customers (name, email, phone, stripe_customer_id)
         VALUES ($1, $2, $3, $4)
         RETURNING *`,
        [name, email, phone, stripeCustomer.id]
      );
      user = insertUser.rows[0];
      stripeCustomerId = stripeCustomer.id;
      isFirstOrder = true;
    }

    // If existing user doesn't have stripe_customer_id, create one
    if (!stripeCustomerId) {
      const stripeCustomer = await stripe.customers.create({
        email: user.email,
        name: user.name,
        phone: user.phone,
        metadata: {
          source: 'quick_booking_update',
          user_id: user.id
        }
      });

      await client.query(
        `UPDATE customers SET stripe_customer_id = $1 WHERE id = $2`,
        [stripeCustomer.id, user.id]
      );
      stripeCustomerId = stripeCustomer.id;
    }

    const addressResult = await client.query(
  `INSERT INTO addresses
   (
     user_id,
     address_type,
     full_address,
     house_number,
     street_name,
     postcode,
     latitude,
     longitude,
     is_selected
   )
   VALUES
   ($1, 'pickup', $2, $3, $4, $5, $6, $7, true)
   RETURNING address_id`,
  [
    user.id,
    full_address,
    house_number,
    street_name,
    postcode,
    latitude,
    longitude
  ]
);

    const address_id = addressResult.rows[0].address_id;

    // 3️⃣ FIND PREVIOUS MANAGER (EXPRESS LOGIC)
    let manager_id = null;
    let driver_id = null;
    let order_status = 'NEW';

    if (!isFirstOrder) {
      const previousOrder = await client.query(
        `SELECT o.manager_id
         FROM orders o
         JOIN laundrymanager lm ON lm.user_id = o.manager_id
         WHERE o.user_id = $1 AND o.manager_id IS NOT NULL
         ORDER BY o.created_at DESC
         LIMIT 1`,
        [user.id]
      );

      if (previousOrder.rows.length > 0) {
        manager_id = previousOrder.rows[0].manager_id;
        order_status = 'COLLECT';

        // Find driver under same manager
        const driverResult = await client.query(
          `SELECT driver_id
           FROM driver
           WHERE manager_id = $1 AND assigned = true
           ORDER BY created_at DESC
           LIMIT 1`,
          [manager_id]
        );

        if (driverResult.rows.length > 0) {
          driver_id = driverResult.rows[0].driver_id;
        }
      }
    }

    // 4️⃣ INSERT ORDER
    const orderResult = await client.query(
      `INSERT INTO orders
       (
         user_id,
         address_id,
         pickup_address_id,
         subtotal,
         tip,
         total,
         collect_slot,
         delivery_slot,
         notes,
         images,
         statusbar,
         status,
         manager_id,
         driver_id,
         has_discount
       )
       VALUES
       ($1, $2, $3, 0, 0, 0, $4, $5, $6, $7, 'EXPRESS', $8, $9, $10, true)
       RETURNING *`,
      [
        user.id,
        address_id,
        address_id,
        collect_slot,
        delivery_slot,
        notes || null,
        Array.isArray(images) ? images : [],
        order_status,
        manager_id,
        driver_id
      ]
    );

    const order = orderResult.rows[0];

    // 5️⃣ GENERATE JWT
    const token = jwt.sign(
      { userId: user.id },
      JWT_SECRET,
      { expiresIn: '8760h' }
    );

    await client.query('COMMIT');

    return res.status(201).json({
      success: true,
      message: 'Quick booking created successfully',
      token,
      user: {
        id: user.id,
        name: user.name,
        phone: user.phone,
        email: user.email
      },
      order: {
        id: order.id,
        status: order.status,
        statusbar: order.statusbar,
        manager_id,
        driver_id
      },
      stripeCustomerId // Return this to frontend
    });

  } catch (error) {
    await client.query('ROLLBACK');
    console.error('QUICK BOOKING ERROR => ', error);

    return res.status(500).json({
      success: false,
      message: 'Failed to create booking'
    });
  } finally {
    client.release();
  }
});
