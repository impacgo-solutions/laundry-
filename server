app.get('/time-slots', async (req, res) => {
  try {
    const {
      date,
      postcode,
      isDelivery,
      pickupDate,
      pickupSlotStart,
      tzOffset = 0,
      format = '24'
    } = req.query;

    if (!date) {
      return res.status(400).json({ error: 'date required' });
    }

    const cleanPostcode = postcode?.toUpperCase().replace(/\s+/g, '');
    const deliveryFlag = isDelivery === 'true';

    /* ========= TIME ========= */
    const offsetMs = parseInt(tzOffset) * 60000;
    const nowClient = new Date(Date.now() + offsetMs);
    const targetClient = new Date(new Date(`${date}T00:00:00Z`).getTime() + offsetMs);

    const weekday = targetClient.getDay() === 0 ? 7 : targetClient.getDay();

    /* ========= AREA ========= */
const areaRes = await pool.query(`
  SELECT * FROM postcodeareas
  WHERE $1 LIKE postcode_prefix || '%'
  LIMIT 1
`, [cleanPostcode]);

const area = areaRes.rows[0] || null;

    /* ========= RULE ========= */
   const ruleRes = await pool.query(`
  SELECT *
  FROM slot_rules
  WHERE (postcode_area_id = $1 OR postcode_area_id IS NULL)
    AND is_active = true
  ORDER BY postcode_area_id DESC   -- 🔥 AREA FIRST, THEN DEFAULT
  LIMIT 1
`, [area?.id || null]);

const rule = ruleRes.rows[0];

    /* ========= DAY WINDOWS ========= */
const windowRes = await pool.query(`
  SELECT *
  FROM daily_time_windows
  WHERE weekday = $1
    AND is_active = true
    AND (postcode_area_id = $2 OR postcode_area_id IS NULL)
  ORDER BY postcode_area_id DESC   -- 🔥 PRIORITY: AREA > DEFAULT
`, [weekday, area?.id || null]);

    let slots = [];

    for (const w of windowRes.rows) {
      const [startHour] = w.start_time.split(':').map(Number);
      const [endHour] = w.end_time.split(':').map(Number);

      const slotDuration = rule.slot_duration_hours;

      for (let h = startHour; h + slotDuration <= endHour; h += slotDuration) {

        const start = new Date(targetClient);
        start.setHours(h,0,0);

        const end = new Date(targetClient);
        end.setHours(h + slotDuration,0,0);

        if (end <= nowClient) continue;

        slots.push({
          start: start.toISOString(),
          end: end.toISOString(),
          label: formatSlotLabel(start, end, format === '24'),
          enabled: true
        });
      }
    }

    /* ========= DELIVERY RULES ========= */

    if (deliveryFlag) {
      // 48H
      if (rule.min_delivery_days > 0 && pickupDate) {
        const minDate = new Date(`${pickupDate}T00:00:00Z`);
        minDate.setDate(minDate.getDate() + rule.min_delivery_days);

        slots = slots.filter(s => new Date(s.start) >= minDate);
      }

      // same day cutoff
      if (pickupDate === date && pickupSlotStart) {
        const [h, m] = pickupSlotStart.split(':').map(Number);

        const pickupTime = new Date(`${pickupDate}T00:00:00Z`);
        pickupTime.setHours(h,m,0);

        const min = new Date(pickupTime.getTime() + rule.same_day_cutoff_hours * 3600000);

        slots = slots.filter(s => new Date(s.start) >= min);
      }
    }

    res.json({ slots });

  } catch (err) {
    console.error(err);
    res.status(500).json({ error: err.message });
  }
});
app.post('/postcode-check', async (req, res) => {
  const { query } = req.body; // input can be postcode or area name
  if (!query || typeof query !== 'string') {
    return res.status(400).json({ error: 'query is required' });
  }

  try {
    // Seeded/admin-entered postcodes are district-level prefixes (e.g. "SW1"),
    // while a real address's postcode is the full code (e.g. "SW1A 2AA").
    // Match by prefix (ignoring case/spaces) instead of exact equality so a
    // full postcode is correctly recognised as being inside its district.
    const sql = `
      SELECT id, name, postcodes
      FROM public.branches b
      WHERE b.name ILIKE '%' || $1 || '%'
         OR EXISTS (
           SELECT 1
           FROM unnest(b.postcodes) AS pc
           WHERE replace(upper($1), ' ', '') LIKE replace(upper(pc), ' ', '') || '%'
         )
      LIMIT 10;
    `;

    const result = await pool.query(sql, [query.trim()]);

    if (result.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: `No service available for "${query}"`,
      });
    }

    return res.json({
      success: true,
      message: 'Service available',
      branches: result.rows,
    });
  } catch (error) {
    console.error('Error checking service:', error);
    res.status(500).json({ error: 'Internal server error' });
  }
});

function formatUKNumber(raw) {
  if (!raw) return null;

  let n = raw.replace(/\D/g, ""); // remove spaces, dashes, symbols

  // If already starts with 44 and has length 12 → OK
  if (n.startsWith("44") && n.length === 12) {
    return "+" + n;
  }

  // If starts with 0 → convert 07XXXXXXXXX → +447XXXXXXXXX
  if (n.startsWith("0")) {
    return "+44" + n.substring(1);
  }

  // If 10 digits or 11 digits without country code → assume UK mobile
  if (n.length === 10 || n.length === 11) {
    return "+44" + n;
  }

  return null; // invalid
}

