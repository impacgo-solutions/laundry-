app.post('/auth/access', async (req, res) => {
  const { name, email, phone, address } = req.body;

  // =========================
  // ✅ VALIDATION
  // =========================
  if (!phone) {
    return res.status(400).json({ success: false, message: 'Phone number is required' });
  }
  if (!email) {
    return res.status(400).json({ success: false, message: 'Email is required' });
  }
  if (!name) {
    return res.status(400).json({ success: false, message: 'Name is required' });
  }
  // No format check existed at all - any garbage string was accepted and
  // persisted as a customer's email, which then can never receive order
  // confirmations/notifications.
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return res.status(400).json({ success: false, message: 'A valid email address is required' });
  }

  try {
    // =========================
    // ✅ FIND OR CREATE USER
    // =========================
    const existingUser = await pool.query(
      `SELECT * FROM customers
       WHERE lower(email) = lower($1) OR lower(phone) = lower($2)
       LIMIT 1`,
      [email, phone]
    );

    let user;
    let isNewUser = false;

    if (existingUser.rows.length > 0) {
      user = existingUser.rows[0];

      const updated = await pool.query(
        `UPDATE customers 
         SET name  = COALESCE(NULLIF($1,''), name),
             email = COALESCE(NULLIF($2,''), email)
         WHERE id = $3 RETURNING *`,
        [name, email.toLowerCase(), user.id]
      );

      user = updated.rows[0];

    } else {
      const insert = await pool.query(
        `INSERT INTO customers (name, email, phone)
         VALUES ($1, $2, $3) RETURNING *`,
        [name, email.toLowerCase(), phone]
      );

      user = insert.rows[0];
      isNewUser = true;
    }

    // =====================================================
    // ✅ STRIPE CUSTOMER (🔥 FIXED PART)
    // =====================================================
    let stripeCustomerId = user.stripe_customer_id;

    if (!stripeCustomerId) {
      try {
        const customer = await stripe.customers.create({
          name: user.name,
          email: user.email,
          phone: user.phone,
        });

        stripeCustomerId = customer.id;

        await pool.query(
          `UPDATE customers 
           SET stripe_customer_id = $1 
           WHERE id = $2`,
          [stripeCustomerId, user.id]
        );

        console.log("✅ Stripe customer created:", stripeCustomerId);

      } catch (stripeErr) {
        console.error("❌ Stripe Error:", stripeErr.message);
      }
    }

    // =========================
    // ✅ ADDRESS SAVE (UNCHANGED)
    // =========================
    if (address && (address.full_address || address.street_name)) {

      const fullAddress = `
${address.house_number || ''} ${address.street_name || ''},
${address.full_address || ''}
`.replace(/\s+/g, ' ').trim();

      console.log("📍 FINAL ADDRESS:", fullAddress);

      const existingAddress = await pool.query(
        `SELECT address_id FROM addresses
         WHERE user_id = $1 
         AND LOWER(full_address) = LOWER($2)
         LIMIT 1`,
        [user.id, fullAddress]
      );

      if (existingAddress.rows.length === 0) {

        await pool.query(
          `UPDATE addresses SET is_selected = false WHERE user_id = $1`,
          [user.id]
        );

        await pool.query(
          `INSERT INTO addresses
            (user_id, address_type, full_address,
             latitude, longitude,
             house_number, street_name, postcode, pincode, is_selected)
           VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9,true)`,
          [
            user.id,
            address.address_type || 'home',
            fullAddress,
            address.latitude  || null,
            address.longitude || null,
            address.house_number || null,
            address.street_name  || null,
            address.postcode     || null,
            address.pincode      || address.postcode || null,
          ]
        );

      } else {
        await pool.query(
          `UPDATE addresses SET is_selected = true WHERE address_id = $1`,
          [existingAddress.rows[0].address_id]
        );
      }
    } else {
      console.log("⚠️ ADDRESS NOT RECEIVED:", address);
    }

    // =========================
    // ✅ JWT TOKEN
    // =========================
    const token = jwt.sign(
      { userId: user.id },
      JWT_SECRET,
      { expiresIn: '8760h' }
    );

    return res.json({
      success: true,
      message: isNewUser ? 'Account created' : 'Login successful',
      isNewUser,
      token,
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        phone: user.phone,
        stripe_customer_id: stripeCustomerId, // ✅ returning
      }
    });

  } catch (err) {

    // =========================
    // ✅ DUPLICATE HANDLING
    // =========================
    if (err.code === '23505') {
      const retry = await pool.query(
        `SELECT * FROM customers 
         WHERE lower(email) = lower($1) OR lower(phone) = lower($2) 
         LIMIT 1`,
        [email, phone]
      );

      const user = retry.rows[0];

      const token = jwt.sign(
        { userId: user.id },
        JWT_SECRET,
        { expiresIn: '8760h' }
      );

      return res.json({
        success: true,
        message: 'Login successful',
        token,
        user
      });
    }

    console.error('❌ AUTH ACCESS ERROR =>', err);
    res.status(500).json({ success: false, message: 'Server error' });
  }
});

app.post('/signup', async (req, res) => {
  const { name, email, phone, password } = req.body;

  if (!name || !email || !phone || !password) {
    return res.status(400).json({
      success: false,
      message: 'All fields are required'
    });
  }

  try {
    // 🔍 Case-insensitive check
    const existingUser = await pool.query(
      `
      SELECT email, phone
      FROM customers
      WHERE LOWER(email) = LOWER($1)
         OR LOWER(phone) = LOWER($2)
      `,
      [email.trim(), phone.trim()]
    );

    if (existingUser.rows.length > 0) {
      const user = existingUser.rows[0];

      if (user.email.toLowerCase() === email.toLowerCase()) {
        return res.status(400).json({
          success: false,
          message: 'Email already exists'
        });
      }

      if (user.phone.toLowerCase() === phone.toLowerCase()) {
        return res.status(400).json({
          success: false,
          message: 'Phone number already exists'
        });
      }
    }

    // 🔐 Hash password
    const hashedPassword = await bcrypt.hash(password, 10);

    // 💾 Insert user
    const result = await pool.query(
      `
      INSERT INTO customers (name, email, phone, password)
      VALUES ($1, $2, $3, $4)
      RETURNING id, name, email, phone
      `,
      [
        name.trim(),
        email.trim().toLowerCase(), // normalize
        phone.trim(),
        hashedPassword
      ]
    );

    const user = result.rows[0];

    // 🔑 JWT
    const token = jwt.sign(
      { userId: user.id },
      JWT_SECRET,
      { expiresIn: '8760h' }
    );

    return res.json({
      success: true,
      message: 'Signup successful',
      data: user,
      token
    });

  } catch (err) {
    // 🛡️ Handle DB unique constraint error
    if (err.code === '23505') {
      return res.status(400).json({
        success: false,
        message: 'Email or phone already exists'
      });
    }

    console.error(err);
    return res.status(500).json({
      success: false,
      error: 'Internal server error'
    });
  }
});


