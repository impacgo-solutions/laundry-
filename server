        o.id as order_id,
        TO_CHAR(o.created_at, 'Mon DD, YYYY') as date,
        o.total,
        o.statusbar as status,
        o.status as overall_status,
        COALESCE(SUM(oi.quantity), 0) as total_quantity
      FROM orders o
      LEFT JOIN order_items oi ON o.id = oi.order_id
      WHERE o.user_id = $1
      GROUP BY o.id, o.created_at, o.total, o.statusbar, o.status
      ORDER BY o.created_at DESC
