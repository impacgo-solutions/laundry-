  const client = await pool.connect();

  try {
    const {
      area_name,
      postcode_prefix,
      delivery_type = 'NORMAL',

      slot_duration_hours = 1,
      pickup_window_start,
      pickup_window_end,
      delivery_window_start,
      delivery_window_end,
      same_day_cutoff_hours = 8,
      min_delivery_days = 0,

      timings   // 🔥 array of { weekday, start_time, end_time }
    } = req.body;

    await client.query('BEGIN');

    /* ================= AREA ================= */
    const areaRes = await client.query(
      `
      INSERT INTO postcodeareas (area_name, postcode_prefix, delivery_type)
      VALUES ($1, $2, $3)
      RETURNING id
      `,
      [area_name, postcode_prefix, delivery_type]
    );

    const areaId = areaRes.rows[0].id;

    /* ================= RULE ================= */
    await client.query(
      `
      INSERT INTO slot_rules (
        postcode_area_id,
        slot_duration_hours,
        pickup_window_start,
        pickup_window_end,
        delivery_window_start,
        delivery_window_end,
        same_day_cutoff_hours,
