function formatSlotLabel(start, end, use24Hour = false) {
  const pad = (n) => n.toString().padStart(2, '0');

  if (use24Hour) {
    return `${pad(start.getHours())}:00 - ${pad(end.getHours())}:00`;
  } else {
    const to12 = (date) => {
      const hours = date.getHours();
      const mins = date.getMinutes();
      const displayHour = hours % 12 || 12;
      const ampm = hours < 12 ? 'AM' : 'PM';
      return `${displayHour}:${mins === 0 ? '00' : mins.toString().padStart(2, '0')} ${ampm}`;
    };
    return `${to12(start)} - ${to12(end)}`;
  }
}

function sameCalendarDay(a, b) {
  if (!a || !b) return false;
  // ensure both are parsed as dates at midnight UTC then take ISO date portion
  const da = new Date(a + 'T00:00:00Z');
  const db = new Date(b + 'T00:00:00Z');
  return da.toISOString().slice(0, 10) === db.toISOString().slice(0, 10);
}
