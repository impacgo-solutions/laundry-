app.post("/register", async (req, res) => {
  const { name, username, password, laundryservicename, phone_number } = req.body;

  if (!name || !username || !password || !laundryservicename || !phone_number) {
    return res.status(400).json({ error: "All fields are required." });
  }

  const client = await pool.connect();

  try {
    await client.query("BEGIN");

    // 1️⃣ Check duplicates
    const nameCheck = await client.query(
      "SELECT user_id FROM laundrymanager WHERE LOWER(name) = LOWER($1)",
      [name]
    );
    if (nameCheck.rows.length > 0) {
      await client.query("ROLLBACK");
      return res.status(409).json({ error: "Manager name already exists." });
    }

    const usernameCheck = await client.query(
      "SELECT user_id FROM laundrymanager WHERE LOWER(username) = LOWER($1)",
      [username]
    );
    if (usernameCheck.rows.length > 0) {
      await client.query("ROLLBACK");
      return res.status(409).json({ error: "Username already exists." });
    }

    // 2️⃣ Create manager
    const hashedPassword = await bcrypt.hash(password, 10);

    const managerRes = await client.query(
      `INSERT INTO laundrymanager
        (name, username, password, laundryservicename, phone_number)
       VALUES ($1, $2, $3, $4, $5)
       RETURNING user_id`,
      [name, username, hashedPassword, laundryservicename, phone_number]
    );

    const managerId = managerRes.rows[0].user_id;

    // 3️⃣ AUTO INSERT COMMISSION CONFIG (MANDATORY)
    await client.query(
      `INSERT INTO commission_config (
         manager_id,
         first_order_percent,
         remaining_order_percent
       )
       VALUES ($1, $2, $3)`,
      [
        managerId,
        0.00, // 👈 default initial value (admin can update later)
        0.00
      ]
    );

    // 4️⃣ COMMIT
    await client.query("COMMIT");

    res.status(201).json({
      success: true,
      user_id: managerId
    });

  } catch (error) {
    await client.query("ROLLBACK");
    console.error("❌ Error during registration:", error);
    res.status(500).json({ error: "Internal server error." });
  } finally {
    client.release();
  }
});

