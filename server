app.post("/stripe/init-setup-intent", authenticate, async (req, res) => {
  try {
    const user_id = req.user.id;

    // 1️⃣ Get Stripe customer
    const db = await pool.query(
      "SELECT stripe_customer_id FROM customers WHERE id=$1",
      [user_id]
    );

    const stripeCustomerId = db.rows[0]?.stripe_customer_id;
    if (!stripeCustomerId) {
      return res.status(400).json({ error: "Stripe customer missing" });
    }

    // 2️⃣ CREATE EPHEMERAL KEY (🔥 REQUIRED FOR MOBILE)
    const ephemeralKey = await stripe.ephemeralKeys.create(
      { customer: stripeCustomerId },
      { apiVersion: "2023-10-16" } // VERY IMPORTANT
    );

    // 3️⃣ CREATE SETUP INTENT
    const setupIntent = await stripe.setupIntents.create({
      customer: stripeCustomerId,
      payment_method_types: ["card"],
      usage: "off_session", // for auto-charge later
    });

    // 4️⃣ RETURN ALL REQUIRED VALUES
    res.json({
      setupIntentClientSecret: setupIntent.client_secret,
      ephemeralKeySecret: ephemeralKey.secret,
      customerId: stripeCustomerId,
    });

  } catch (err) {
    console.error("SetupIntent ERROR:", err);
    res.status(500).json({ error: err.message });
  }
});
