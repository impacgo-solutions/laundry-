async function getHourlyOrderDistribution(pool, days = null) {
  const dateFilter = days
    ? `WHERE created_at >= NOW() - INTERVAL '${days} days'`
    : '';

  const result = await pool.query(`
    SELECT 
      EXTRACT(HOUR FROM created_at)::int AS hour,
      TO_CHAR(
        (TIMESTAMP '2000-01-01' + (EXTRACT(HOUR FROM created_at)::int || ' hours')::interval),
        'HH12 AM'
      ) AS hour_label,
      COUNT(*) AS total_orders,
      ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 1) AS percentage
    FROM public.orders
    ${dateFilter}
    GROUP BY EXTRACT(HOUR FROM created_at)
    ORDER BY total_orders DESC
  `);

  return result.rows;
}

async function getPeakHour(pool, days = null) {
  const rows = await getHourlyOrderDistribution(pool, days);
  return rows[0] || null;
}

async function getDayOfWeekDistribution(pool, days = null) {
  const dateFilter = days
    ? `WHERE created_at >= NOW() - INTERVAL '${days} days'`
    : '';

  const result = await pool.query(`
    SELECT 
      EXTRACT(DOW FROM created_at)::int AS day_num,
      TO_CHAR(created_at, 'Day') AS day_name,
      COUNT(*) AS total_orders,
      ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 1) AS percentage
    FROM public.orders
    ${dateFilter}
    GROUP BY EXTRACT(DOW FROM created_at), TO_CHAR(created_at, 'Day')
    ORDER BY total_orders DESC
  `);

  return result.rows;
}

async function getWeeklyTrend(pool) {
  const result = await pool.query(`
    SELECT 
      DATE_TRUNC('week', created_at)::date AS week_start,
      COUNT(*) AS total_orders,
      ROUND(AVG(total)::numeric, 2) AS avg_order_value
    FROM public.orders
    WHERE created_at >= NOW() - INTERVAL '12 weeks'
    GROUP BY DATE_TRUNC('week', created_at)
    ORDER BY week_start DESC
    LIMIT 12
  `);

  return result.rows;
}

async function getOrderSummary(pool, days = null) {
  const dateFilter = days
    ? `WHERE created_at >= NOW() - INTERVAL '${days} days'`
    : '';

  const result = await pool.query(`
    SELECT 
      COUNT(*) AS total_orders,
      COUNT(CASE WHEN status = 'DROPPED' THEN 1 END) AS completed_orders,
      COUNT(CASE WHEN status = 'CANCELLED' THEN 1 END) AS cancelled_orders,
      COUNT(CASE WHEN status = 'NEW' THEN 1 END) AS new_orders,
      ROUND(AVG(total)::numeric, 2) AS avg_order_value,
      ROUND(SUM(total)::numeric, 2) AS total_revenue
    FROM public.orders
    ${dateFilter}
  `);

  return result.rows[0];
}

