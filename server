app.delete("/categories/:id", authenticateAdmin, async (req, res) => {
  try {
    const { id } = req.params;

    // First, check if the category exists
    const checkResult = await pool.query(
      "SELECT * FROM categories WHERE id = $1",
      [id]
    );

    if (checkResult.rows.length === 0) {
      return res.status(404).json({ error: "Category not found" });
    }

    // No FK constraint actually exists on category_id anywhere in this schema,
    // so without this check the delete below "succeeds" silently while
    // leaving sub_categories/products permanently orphaned (category_id
    // pointing at a row that no longer exists, un-fixable from the UI).
    const [depSub, depProd] = await Promise.all([
      pool.query("SELECT COUNT(*) FROM sub_categories WHERE category_id = $1", [id]),
      pool.query("SELECT COUNT(*) FROM products WHERE category_id = $1", [id]),
    ]);
    if (Number(depSub.rows[0].count) > 0 || Number(depProd.rows[0].count) > 0) {
      return res.status(409).json({
        error: "Cannot delete category. It is being referenced by other records. Please remove associated records first."
      });
    }

    const { rows } = await pool.query(
      "DELETE FROM categories WHERE id = $1 RETURNING *",
      [id]
    );

    res.json({ 
      success: true, 
      message: "Category deleted successfully",
      data: rows[0] 
    });
  } catch (err) {
    console.error("Error deleting category:", err);
    
    // Handle foreign key constraint violations
    if (err.code === '23503') { // PostgreSQL foreign key violation code
      return res.status(409).json({ 
        error: "Cannot delete category. It is being referenced by other records. Please remove associated records first."
      });
    }
    
    res.status(500).json({ error: "Internal server error" });
  }
});
