app.post("/lm/check", async (req, res) => {
  try {
    const { username, password } = req.body;

    if (!username || !password) {
      return res.status(400).json({ error: "Username and password required" });
    }

    // --- STEP 1: CHECK IN Laundry Manager TABLE (case-insensitive) ---
    const managerQuery = `
      SELECT user_id, name, username, password
      FROM laundrymanager
      WHERE LOWER(username) = LOWER($1)
      LIMIT 1;
    `;
    const managerResult = await pool.query(managerQuery, [username]);

    if (managerResult.rows.length > 0) {
      const manager = managerResult.rows[0];
      const isMatch = await bcrypt.compare(password, manager.password);

      if (isMatch) {
        const token = jwt.sign(
          { id: manager.user_id, role: "manager" },
          JWT_SECRET,
          { expiresIn: "7d" }
        );

        return res.status(200).json({
          message: "Login successful",
          role: "manager",
          token,
          user: {
            user_id: manager.user_id,
            name: manager.name,
            username: manager.username,
          },
        });
      } else {
        return res.status(401).json({ error: "Invalid password" });
      }
    }

    // --- STEP 2: CHECK IN Driver TABLE (case-insensitive) ---
    const driverQuery = `
      SELECT driver_id, name, username, password, manager_id, assigned
      FROM driver
      WHERE LOWER(username) = LOWER($1)
      LIMIT 1;
    `;
    const driverResult = await pool.query(driverQuery, [username]);

    if (driverResult.rows.length > 0) {
      const driver = driverResult.rows[0];

      // ✅ Compare hashed passwords using bcrypt
      const isMatch = await bcrypt.compare(password, driver.password);

      if (isMatch) {
        const token = jwt.sign(
          { id: driver.driver_id, role: "driver" },
          JWT_SECRET,
          { expiresIn: "7d" }
        );

        return res.status(200).json({
          message: "Login successful",
          role: "driver",
          token,
          user: {
            user_id: driver.driver_id,
            name: driver.name,
            username: driver.username,
            manager_id: driver.manager_id,
            assigned: driver.assigned,
          },
        });
      } else {
        return res.status(401).json({ error: "Invalid password" });
      }
    }

    // --- STEP 3: USER NOT FOUND ---
    return res.status(404).json({ error: "User not found" });

  } catch (error) {
    console.error("❌ Login error:", error.message);
    return res.status(500).json({ error: "Internal Server Error" });
  }
});

app.post("/approvalrequest", async (req, res) => {
  try {
    const { order_id, note, image_name, image_base64, type, manager_id, amount } = req.body;

    console.log("📨 Received approval request:", {
      order_id,
      note: note ? `${note.substring(0, 50)}...` : 'empty',
      image_name: image_name || 'not provided',
      image_base64: image_base64 ? `present (${image_base64.length} chars)` : 'not provided',
      type: type || 'not specified',
      manager_id: manager_id || 'not provided'
    });

    // Basic validation
    if (!order_id || !note) {
      console.log("❌ Missing required fields:", { order_id: !!order_id, note: !!note });
      return res.status(400).json({ error: "Missing required fields: order_id and note are required" });
    }

    // For damage approvals, image is required
    if (type === 'damage' && (!image_name || !image_base64)) {
      console.log("❌ Damage approval requires image");
      return res.status(400).json({ error: "Image is required for damage approval" });
    }

    // Dead code below this point (see the real, auth-protected handler
    // earlier in the file) - kept consistent anyway so it isn't a trap if
    // ever re-enabled: a price approval needs a positive amount, or
    // approving it later would do nothing (or worse, reduce the total).

    // A price approval must carry a real ₹ amount, or approving it later has
    // nothing to actually add to the order's total - the note text alone
    // (e.g. "stain treatment - ₹10") is only for display, never parsed back.
    if (type === 'price' && (amount === undefined || amount === null || isNaN(parseFloat(amount)))) {
      console.log("❌ Price approval requires a numeric amount");
      return res.status(400).json({ error: "A numeric amount is required for price approval" });
    }

    let query, values;

    if (type === 'price') {
      // Price approval - no image
      query = `
        INSERT INTO public.approval_requests (order_id, note, status, created_at, type, manager_id, amount)
        VALUES ($1, $2, 'pending', NOW(), $3, $4, $5)
        RETURNING *;
      `;
      values = [order_id, note, type, manager_id || null, parseFloat(amount)];
    } else {
      // Damage approval or legacy - with image
      query = `
        INSERT INTO public.approval_requests (order_id, note, image_name, image_base64, status, created_at, type, manager_id)
        VALUES ($1, $2, $3, $4, 'pending', NOW(), $5, $6)
        RETURNING *;
      `;
      values = [order_id, note, image_name, image_base64, type || 'damage', manager_id || null];
    }

    console.log("💾 Executing query:", query);
    const result = await pool.query(query, values);
    const approval = result.rows[0];

    console.log("✅ Data inserted successfully, ID:", approval.id);

    // AUTO-SEND NOTIFICATION TO CUSTOMER
    try {
      const customerTokenResult = await pool.query(
        `SELECT c.fcm_token FROM public.orders o 
         JOIN public.customers c ON o.user_id = c.id 
         WHERE o.id = $1`,
        [order_id]
      );

      if (customerTokenResult.rows.length > 0 && customerTokenResult.rows[0].fcm_token) {
        const customerToken = customerTokenResult.rows[0].fcm_token;
        
        const notificationTitle = type === 'price' ? '💰 Price Approval Request' : '🔄 Damage Approval Request';
        const notificationBody = type === 'price' 
          ? 'Manager has sent a price approval request for your order'
          : 'Manager has sent a damage approval request for your order';

        const message = {
          token: customerToken,
          notification: {
            title: notificationTitle,
            body: notificationBody,
          },
          data: {
            type: type === 'price' ? 'price_approval' : 'damage_approval',
            requestId: approval.id.toString(),
            orderId: order_id.toString(),
            note: note,
            timestamp: new Date().toISOString(),
          },
        };

        await customerMessaging.send(message);
        console.log(`✅ Auto-sent FCM notification to customer for approval: ${approval.id}`);
      } else {
        console.log(`⚠️ No customer FCM token found for order: ${order_id}`);
      }
    } catch (notificationError) {
      console.error(`❌ Error auto-sending notification:`, notificationError);
      // Don't fail the main request if notification fails
    }

    res.status(201).json({
      success: true,
      message: "Approval request stored successfully",
      data: approval,
    });

  } catch (error) {
    console.error("❌ Error inserting approval request:", error);
    res.status(500).json({ error: "Failed to store approval request: " + error.message });
  }
});
