app.get('/api/order/:orderId/timeline', async (req, res) => {
  try {
    const { orderId } = req.params;

    const timelineQuery = `
      SELECT 
        created_at as order_created,
        picked_time,
        prelaundry_time,
        delivery_time,
        dropped_time,
        statusbar as current_status
      FROM orders 
      WHERE id = $1
    `;

    const result = await pool.query(timelineQuery, [orderId]);
    
    if (result.rows.length === 0) {
      return res.status(404).json({
        success: false,
        error: 'Order not found'
      });
    }

    const order = result.rows[0];
    
    const timeline = [];
    
    if (order.order_created) {
      timeline.push({
        event: 'Order Created',
        timestamp: order.order_created,
        status: 'ORDER_CREATED'
      });
    }
    
    if (order.picked_time) {
      timeline.push({
        event: 'Order Picked Up',
        timestamp: order.picked_time,
        status: 'PICKED_UP'
      });
    }
    
    if (order.prelaundry_time) {
      timeline.push({
        event: 'Prelaundry Processing',
        timestamp: order.prelaundry_time,
        status: 'PRELAUNDRY'
      });
    }
    
    if (order.delivery_time) {
      timeline.push({
        event: 'Out for Delivery',
