// DELETE laundry manager by ID
app.delete('/laundry-managers/:id', authenticateAdmin, async (req, res) => {
  const managerId = req.params.id;

  try {
    // Validate UUID format
    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
    if (!uuidRegex.test(managerId)) {
      return res.status(400).json({
        success: false,
        message: 'Invalid manager ID format'
      });
    }

    const client = await pool.connect();

    try {
      await client.query('BEGIN');

      // Check if manager exists
      const checkManager = await client.query(
        'SELECT user_id, name FROM laundrymanager WHERE user_id = $1',
        [managerId]
      );

      if (checkManager.rows.length === 0) {
        await client.query('ROLLBACK');
        return res.status(404).json({
          success: false,
          message: 'Laundry manager not found'
        });
      }

      // First, check if manager has any associated drivers
      const checkDrivers = await client.query(
        'SELECT COUNT(*) as driver_count FROM driver WHERE manager_id = $1',
        [managerId]
      );

      const driverCount = parseInt(checkDrivers.rows[0].driver_count);

      if (driverCount > 0) {
        await client.query('ROLLBACK');
        return res.status(409).json({
          success: false,
          message: `Cannot delete manager. ${driverCount} driver(s) are assigned to this manager. Please reassign or delete drivers first.`
        });
      }

      // No FK constraint exists on orders.manager_id - without this check,
      // deleting a manager who still has orders leaves those orders stuck
      // with a dangling manager_id no one can act on (the manager's own
      // login is gone, so /lm/orders and similar manager-scoped views can
      // never surface them again).
      const checkOrders = await client.query(
        'SELECT COUNT(*) as order_count FROM orders WHERE manager_id = $1',
        [managerId]
      );
      const orderCount = parseInt(checkOrders.rows[0].order_count);
      if (orderCount > 0) {
        await client.query('ROLLBACK');
        return res.status(409).json({
          success: false,
          message: `Cannot delete manager. ${orderCount} order(s) are assigned to this manager. Please reassign those orders first.`
        });
      }

      // Delete the manager
      const deleteResult = await client.query(
        'DELETE FROM laundrymanager WHERE user_id = $1 RETURNING user_id, name, username',
        [managerId]
      );

      await client.query('COMMIT');

      res.json({
        success: true,
        message: 'Laundry manager deleted successfully',
        data: {
          user_id: deleteResult.rows[0].user_id,
          name: deleteResult.rows[0].name,
          username: deleteResult.rows[0].username
        }
      });

    } catch (error) {
      await client.query('ROLLBACK');
      throw error;
    } finally {
      client.release();
    }

  } catch (error) {
    console.error('Error deleting laundry manager:', error);
    
    // Handle other potential constraint violations
    if (error.code === '23503') {
      return res.status(409).json({
        success: false,
        message: 'Cannot delete manager. Manager is associated with other records in the system.'
      });
    }

    res.status(500).json({
      success: false,
      message: 'Internal server error while deleting manager'
    });
  }
});
