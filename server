app.put("/wallet/apply", authenticate, async (req, res) => {
  try {
    const customerId = req.user.id;
    const { order_total } = req.body;

    const customer = await pool.query(
      `SELECT wallet_balance FROM customers WHERE id=$1`,
      [customerId]
    );

    const balance = Number(customer.rows[0].wallet_balance);
    const settings = await pool.query(`
      SELECT key,value FROM app_settings
      WHERE key IN ('wallet_max_usage_per_order','wallet_threshold')
    `);
    let maxUsage = 0;
    let threshold = 0;
    settings.rows.forEach((row) => {
      if (row.key === "wallet_max_usage_per_order")
        maxUsage = Number(row.value);
      if (row.key === "wallet_threshold")
        threshold = Number(row.value);
    });
    if (order_total < threshold) {
      return res.json({
        success:false,
        message:`Wallet can be used only above ₹${threshold}`
      });
    }
    const walletUsed = Math.min(balance, maxUsage, order_total);
    res.json({
      success:true,
      walletUsed,
      remainingWallet: balance - walletUsed
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({success:false});
  }
});

