      // cleared once an order reaches a terminal state, so a cancelled
      // order that had already progressed would keep showing its old
      // in-progress stage instead of CANCELLED. Terminal states must win.
      const overall = (row.overall_status || '').toUpperCase();
      const isTerminal = ['CANCELLED', 'REJECTED', 'DELIVERED'].includes(overall);
      const status = isTerminal
        ? row.overall_status
        : (row.status || row.overall_status || 'Unknown');

      return {
        order_id: orderId,
        date: date,
        items: items,
        total: total,
        status: status
      };
