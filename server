app.put("/api/orders/update-receive", async (req, res) => {
  const client = await pool.connect();
  try {
    const { order_id, product_id, new_receive } = req.body;

    if (!order_id || !product_id || new_receive === undefined) {
      return res.status(400).json({ message: "Missing required fields" });
    }

    await client.query("BEGIN");

    // 1️⃣ Update the quantity for the specific item
    const updateItemQuery = `
      UPDATE order_items
      SET quantity = $1
      WHERE order_id = $2 AND product_id = $3
      RETURNING *;
    `;
    const updatedItem = await client.query(updateItemQuery, [new_receive, order_id, product_id]);

    if (updatedItem.rowCount === 0) {
      await client.query("ROLLBACK");
      return res.status(404).json({ message: "Order item not found" });
    }

    // 2️⃣ Recalculate subtotal for the order
    const subtotalQuery = `
      SELECT SUM(quantity * price_at_purchase) AS subtotal
      FROM order_items
      WHERE order_id = $1
    `;
    const subtotalResult = await client.query(subtotalQuery, [order_id]);
    const subtotal = subtotalResult.rows[0].subtotal || 0;

    // 3️⃣ Update orders table with new subtotal and total
    const updateOrderQuery = `
      UPDATE orders
      SET subtotal = $1,
          total = $1 + tip
      WHERE id = $2
      RETURNING *;
    `;
    const updatedOrder = await client.query(updateOrderQuery, [subtotal, order_id]);

    await client.query("COMMIT");

    res.json({
      message: `Updated item and recalculated totals`,
      updatedItem: updatedItem.rows[0],
      updatedOrder: updatedOrder.rows[0],
    });
  } catch (error) {
    await client.query("ROLLBACK");
    console.error("Error updating order item:", error);
    res.status(500).json({ message: "Internal Server Error", error });
  } finally {
    client.release();
  }
});



