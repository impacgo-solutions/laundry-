app.post("/send_invoice_to_customer", async (req, res) => {
  const { order_id } = req.body;

  try {

    // 1️⃣ GET INVOICE
    const invoiceRes = await pool.query(
      "SELECT * FROM invoice WHERE order_id=$1",
      [order_id]
    );

    const invoice = invoiceRes.rows[0];
    if (!invoice) {
      return res.status(404).json({ error: "Invoice not found" });
    }

    // 2️⃣ FETCH CUSTOMER
    const customerRes = await pool.query(
      "SELECT * FROM customers WHERE id=$1",
      [invoice.customer_id]
    );

    const customer = customerRes.rows[0];
    if (!customer) {
      return res.status(404).json({ error: "Customer not found" });
    }

    // 3️⃣ FETCH ORDER + ADDRESS
    const orderRes = await pool.query(
      `SELECT o.*, a.full_address, a.postcode, a.house_number, a.street_name
       FROM orders o
       JOIN addresses a ON o.address_id = a.address_id
       WHERE o.id=$1`,
      [order_id]
    );

    const order = orderRes.rows[0];
    if (!order) {
      return res.status(404).json({ error: "Order not found" });
    }

    // 4️⃣ FETCH ORDER ITEMS
    const itemsRes = await pool.query(
      `SELECT oi.*, p.name AS product_name
       FROM order_items oi
       JOIN products p ON oi.product_id = p.id
       WHERE oi.order_id=$1`,
      [order_id]
    );

    const items = itemsRes.rows;

    // 5️⃣ GENERATE PDF
    const pdf = await generateInvoicePDF(invoice, customer, items, order);

    // 6️⃣ CREATE STRIPE CHECKOUT SESSION
    const session = await stripe.checkout.sessions.create({
      payment_method_types: ["card"],
      mode: "payment",

      customer_email: customer.email,

      line_items: [
        {
          price_data: {
            currency: "inr",
            product_data: {
              name: `Invoice #${invoice.invoice_id}`
            },
            unit_amount: Math.round(invoice.total_amount * 100)
          },
          quantity: 1
        }
      ],

      success_url: `https://impacgo.com/payment-success`,
      cancel_url: `https://impacgo.com/payment-cancel`,

      metadata: {
        invoice_id: invoice.invoice_id
      }
    });

    const paymentLink = session.url;

    // 7️⃣ SAVE PAYMENT LINK
    await pool.query(
      `UPDATE invoice
       SET payment_link=$1
       WHERE invoice_id=$2`,
      [paymentLink, invoice.invoice_id]
    );

    // 8️⃣ SEND EMAIL
    await transporter.sendMail({
      from: '"ImpacGo Support" <support@impacgo.com>',
      to: customer.email,
      subject: `Your Invoice #${invoice.invoice_id}`,
      html: `
        <h3>Hi ${customer.name},</h3>

        <p>Your invoice is attached.</p>

        <p><b>Total Amount:</b> ₹${Number(invoice.total_amount).toFixed(2)}</p>

        <p>You can pay securely using Stripe:</p>

        <a href="${paymentLink}"
          style="
            display:inline-block;
            background:#635BFF;
            color:#ffffff;
            padding:12px 20px;
            text-decoration:none;
            border-radius:6px;
            font-weight:bold;
          ">
          Pay Invoice
        </a>

        <p>This amount will be auto-charged in <b>4 hours</b> if unpaid.</p>

        <br/>
        <p>Ironing Boy Team</p>
      `,
      attachments: [
        {
          filename: `invoice_${invoice.invoice_id}.pdf`,
          content: pdf
        }
      ]
    });

    // 9️⃣ CANCEL OLD AUTO-CHARGE TIMER
    if (autoChargeTimers.has(invoice.invoice_id)) {
      clearTimeout(autoChargeTimers.get(invoice.invoice_id));
      autoChargeTimers.delete(invoice.invoice_id);
    }

    // 🔟 AUTO CHARGE AFTER 4 HOURS
    const timer = setTimeout(async () => {
      try {

        const check = await pool.query(
          "SELECT status FROM invoice WHERE invoice_id=$1",
          [invoice.invoice_id]
        );

        if (check.rows[0]?.status === "paid") {
          console.log("Invoice already paid:", invoice.invoice_id);
          return;
        }

        const result = await autoChargeInvoice(invoice.invoice_id);

        if (result.success) {
          console.log("Auto charge success:", invoice.invoice_id);
        } else {
          console.error("Auto charge failed:", result.error);
        }

      } catch (err) {
        console.error("Auto charge error:", err.message);
      } finally {
        autoChargeTimers.delete(invoice.invoice_id);
      }

    }, 4 * 60 * 60 * 1000);

    autoChargeTimers.set(invoice.invoice_id, timer);

    res.json({
      success: true,
      message: "Invoice sent successfully",
      payment_link: paymentLink
    });

  } catch (err) {
    console.error("Send invoice error:", err);
    res.status(500).json({ error: err.message });
  }
});
function generateInvoicePDF(invoice, customer, items, order) {
