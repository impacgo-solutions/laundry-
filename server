      pass: item.pass
    }));

    // Calculate items count and subtotal from items
    const itemsCount = itemsResult.rows.reduce((sum, item) => sum + item.quantity, 0);
    const calculatedSubtotal = itemsResult.rows.reduce((sum, item) => 
      sum + ((item.price_at_purchase || 0) * item.quantity), 0
    );

