      discount_percent,
      order_limit,
      student_extra_percent,
      is_active = true,
    } = req.body;

    const validationError = validateDiscountFields({ min_amount, discount_percent, order_limit });
    if (validationError) {
      return res.status(400).json({ error: validationError });
    }

    // service_charge/minimum_amount used to be inserted here but neither
    // column exists on discount_settings (nor does the frontend ever send
    // them) - every single "Add Discount" submission failed with a 500.
    const query = `
      INSERT INTO discount_settings
      (min_amount, max_amount, discount_percent, order_limit, student_extra_percent, is_active)
      VALUES ($1, $2, $3, $4, $5, $6)
