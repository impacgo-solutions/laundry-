app.get("/products1", async (req, res) => {
  try {
    const userTypeId = req.user?.user_type_id || null;
    const categoryId = req.query.categoryId || null;
    const subCategoryId = req.query.subCategoryId || null;
    const search = req.query.search || null;
 
    let params = [];
    let index = 1;
 
    let priceCase =
      userTypeId === 1
        ? "put.standard_price"
        : userTypeId === 2
        ? "put.offer_price"
        : "put.standard_price";
 
    let query = `
      SELECT 
        p.id,
        p.name,
        p.emoji,
        p.sub_category_id,
        p.category_id,
        p.size,
        p.material,
        p.treatment,
        p.packing,
        ${priceCase} AS price
      FROM products p
      JOIN product_user_types put ON p.id = put.product_id
      WHERE 1=1
    `;
 
    if (categoryId) {
      query += ` AND p.category_id = $${index++}`;
      params.push(categoryId);
    }
 
    if (subCategoryId) {
      query += ` AND p.sub_category_id = $${index++}`;
      params.push(subCategoryId);
    }
 
    if (search) {
      query += ` AND p.name ILIKE $${index++}`;
      params.push(`%${search}%`);
    }
 
    // Ensure correct user type price mapping
