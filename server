app.put("/api/admin/global-settings", authenticateAdmin, async (req, res) => {
  try {
    const { service_charge, minimum_amount } = req.body;

    // Build dynamic update query
    const updates = [];
    const values = [];
    let paramIndex = 1;

    if (service_charge !== undefined) {
      updates.push(`service_charge = $${paramIndex++}`);
      values.push(service_charge);
    }
    if (minimum_amount !== undefined) {
      updates.push(`minimum_amount = $${paramIndex++}`);
      values.push(minimum_amount);
    }

    // Always update the timestamp
    updates.push(`updated_at = CURRENT_TIMESTAMP`);

    if (updates.length === 1) {
      // Only timestamp – no actual changes
      return res.status(400).json({ error: "No fields to update" });
    }

    const query = `
      UPDATE global_settings
      SET ${updates.join(", ")}
      WHERE id = 1
      RETURNING service_charge, minimum_amount, updated_at
    `;

    const result = await pool.query(query, values);

    if (result.rows.length === 0) {
      // Row doesn't exist – insert with provided values
      const insertQuery = `
        INSERT INTO global_settings (id, service_charge, minimum_amount)
        VALUES (1, $1, $2)
        RETURNING service_charge, minimum_amount, updated_at
      `;
      const insertValues = [
        service_charge !== undefined ? service_charge : 2.0,
        minimum_amount !== undefined ? minimum_amount : null,
      ];
      const insertResult = await pool.query(insertQuery, insertValues);
      return res.json({
        message: "Global settings created",
        data: insertResult.rows[0],
      });
    }

    res.json({
      message: "Global settings updated successfully",
      data: result.rows[0],
    });
  } catch (err) {
    console.error("PUT global settings error:", err);
    res.status(500).json({ error: "Server error" });
  }
});
app.post('/booking-new-order', async (req, res) => {
  const {
    name,
    email,
    phone,
    street_address,
    postcode,
    additional_details,
    use_same_address = true,
    delivery_address,
    delivery_postcode,
    delivery_additional_details,
    collect_slot,
    delivery_slot,
    notes,
  } = req.body;
 
  // ── Validation ─────────────────────────────────────────────────────────────
  const missing = [];
  if (!name)                missing.push('name');
  if (!phone && !email)     missing.push('phone or email');
  if (!street_address)      missing.push('street_address');
  if (!collect_slot)        missing.push('collect_slot');
  if (!delivery_slot)       missing.push('delivery_slot');
 
  if (missing.length > 0) {
    return res.status(400).json({
      success: false,
      message: `Missing required fields: ${missing.join(', ')}`,
    });
  }
 
  const client = await pool.connect();
 
  try {
    await client.query('BEGIN');
 
    // ── STEP 1: Get or Create Customer ─────────────────────────────────────
    let customer = null;
 
    // Try find by phone
    if (phone) {
      const byPhone = await client.query(
        `SELECT id, name, email, phone
           FROM customers
          WHERE lower(phone) = lower($1)
          LIMIT 1`,
        [phone]
      );
      if (byPhone.rows.length > 0) customer = byPhone.rows[0];
    }
 
    // Try find by email if not found by phone
    if (!customer && email) {
      const byEmail = await client.query(
        `SELECT id, name, email, phone
           FROM customers
          WHERE lower(email) = lower($1)
          LIMIT 1`,
        [email]
      );
      if (byEmail.rows.length > 0) customer = byEmail.rows[0];
    }
 
    // Create new customer if not found
    if (!customer) {
      const inserted = await client.query(
        `INSERT INTO customers (name, email, phone, user_type_id)
              VALUES ($1, $2, $3, 1)
         RETURNING id, name, email, phone`,
        [
          name  || 'Unknown',
          email || null,
          phone || null,
        ]
      );
      customer = inserted.rows[0];
    }
 
    const customerId = customer.id;
 
    // ── STEP 2: Get or Create Pickup Address ───────────────────────────────
    const cleanPickupPostcode = (postcode || '').replace(/\s/g, '').toUpperCase();
 
    let pickupAddressId = null;
 
    // Check if address already exists for this customer with same postcode
    if (cleanPickupPostcode) {
      const existingPickup = await client.query(
        `SELECT address_id
           FROM addresses
          WHERE user_id = $1
            AND replace(upper(coalesce(postcode, '')), ' ', '') = $2
          LIMIT 1`,
        [customerId, cleanPickupPostcode]
      );
      if (existingPickup.rows.length > 0) {
        pickupAddressId = existingPickup.rows[0].address_id;
      }
    }
 
    // Insert new pickup address if not found
    if (!pickupAddressId) {
      const insertedPickup = await client.query(
        `INSERT INTO addresses
               (user_id, address_type, full_address, additional_details,
                postcode, pincode, is_selected)
          VALUES ($1, 'pickup', $2, $3, $4, $4, false)
          RETURNING address_id`,
        [
          customerId,
          street_address      || '',
          additional_details  || null,
          cleanPickupPostcode || null,
        ]
      );
      pickupAddressId = insertedPickup.rows[0].address_id;
    }
 
    // ── STEP 3: Get or Create Delivery Address ─────────────────────────────
    let deliveryAddressId = null;
 
    if (use_same_address) {
      // Reuse pickup address as delivery
      deliveryAddressId = pickupAddressId;
    } else {
      const cleanDeliveryPostcode = (delivery_postcode || '').replace(/\s/g, '').toUpperCase();
 
      // Check if delivery address already exists for this customer
      if (cleanDeliveryPostcode) {
        const existingDelivery = await client.query(
          `SELECT address_id
             FROM addresses
            WHERE user_id = $1
              AND replace(upper(coalesce(postcode, '')), ' ', '') = $2
            LIMIT 1`,
          [customerId, cleanDeliveryPostcode]
        );
        if (existingDelivery.rows.length > 0) {
          deliveryAddressId = existingDelivery.rows[0].address_id;
        }
      }
 
      // Insert new delivery address if not found
      if (!deliveryAddressId) {
        const insertedDelivery = await client.query(
          `INSERT INTO addresses
                 (user_id, address_type, full_address, additional_details,
                  postcode, pincode, is_selected)
            VALUES ($1, 'delivery', $2, $3, $4, $4, false)
            RETURNING address_id`,
          [
            customerId,
            delivery_address              || street_address || '',
            delivery_additional_details   || null,
            cleanDeliveryPostcode         || null,
          ]
        );
        deliveryAddressId = insertedDelivery.rows[0].address_id;
      }
    }
 
    // ── STEP 4: Create Order ───────────────────────────────────────────────
    const orderResult = await client.query(
      `INSERT INTO orders
             (user_id,
              address_id,
              pickup_address_id,
              subtotal,
              tip,
              total,
              collect_slot,
              delivery_slot,
              notes,
              images,
              status,
              statusbar,
              use_same_address)
       VALUES ($1, $2, $3,
               0, 0, 0,
               $4, $5, $6,
               '{}',
               'NEW',
               'PENDING',
               $7)
       RETURNING id, status, statusbar, created_at`,
      [
        customerId,
        deliveryAddressId,
        pickupAddressId,
        collect_slot,
        delivery_slot,
        notes           || null,
        use_same_address,
      ]
    );
 
    await client.query('COMMIT');
 
    const order = orderResult.rows[0];
 
    return res.status(201).json({
      success: true,
      message: 'Booking confirmed successfully!',
      order: {
        id          : order.id,
        status      : order.status,
        statusbar   : order.statusbar,
        created_at  : order.created_at,
        collect_slot,
        delivery_slot,
      },
      customer: {
        id   : customer.id,
        name : customer.name,
        email: customer.email,
        phone: customer.phone,
      },
    });
 
  } catch (err) {
    await client.query('ROLLBACK');
    console.error('[/booking-new-order] Error:', err);
 
    if (err.code === '23505') {
      if (err.constraint?.includes('email')) {
        return res.status(409).json({
          success: false,
          message: 'A customer with this email already exists.',
        });
      }
      if (err.constraint?.includes('phone')) {
        return res.status(409).json({
          success: false,
          message: 'A customer with this phone number already exists.',
        });
      }
    }
 
    return res.status(500).json({
      success: false,
      message: 'Internal server error. Please try again.',
    });
 
  } finally {
    client.release();
  }
});
