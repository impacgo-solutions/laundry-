    `);
    const discountSettings = discountSettingsRes.rows || [];
    console.log(`${DEBUG_TAG} discount rules found:`, discountSettings.length);
    if (discountSettings.length === 0) {
      console.warn(`${DEBUG_TAG} ⚠️  NO active discount rules in discount_settings table!`);
    }
    discountSettings.forEach((rule, i) => {
      console.log(`${DEBUG_TAG}   rule[${i}]:`, {
        id: rule.id,
        min_amount: rule.min_amount,
        max_amount: rule.max_amount,
        discount_percent: rule.discount_percent,
        order_limit: rule.order_limit,
        student_extra_percent: rule.student_extra_percent,
        is_active: rule.is_active,
      });
    });

    // ── 5. Minimum top-up handling ─────────────────────────
    let minTopupApplied = false;
    let topupAmount = 0;
    let effectiveAmount = bookingAmount;

    if (bookingAmount < minimumOrderAmount) {
      minTopupApplied = true;
      topupAmount = minimumOrderAmount - bookingAmount;
      effectiveAmount = minimumOrderAmount;
      console.log(`${DEBUG_TAG} ⚠️  bookingAmount (${bookingAmount}) < minimumOrderAmount (${minimumOrderAmount})`);
      console.log(`${DEBUG_TAG}    topupAmount=${topupAmount}, effectiveAmount=${effectiveAmount}`);
    } else {
      console.log(`${DEBUG_TAG} ✅ bookingAmount (${bookingAmount}) >= minimumOrderAmount (${minimumOrderAmount}), no top-up needed`);
    }

    // ── 6. Match discount rule ─────────────────────────────
    let discountPercent = 0;
    let appliedRule = null;

    console.log(`${DEBUG_TAG} matching rules against: effectiveAmount=${effectiveAmount}, orderCount=${orderCount}`);
    for (const rule of discountSettings) {
      const minAmount = Number(rule.min_amount);
      const maxAmount = rule.max_amount ? Number(rule.max_amount) : null;
      const orderLimit = Number(rule.order_limit);

      const passesMinAmount = effectiveAmount >= minAmount;
      const passesMaxAmount = maxAmount === null || effectiveAmount <= maxAmount;
      const passesOrderLimit = orderCount < orderLimit;

      console.log(`${DEBUG_TAG}   checking rule id=${rule.id}:`, {
        minAmount, maxAmount, orderLimit,
        passesMinAmount, passesMaxAmount, passesOrderLimit,
        wouldMatch: passesMinAmount && passesMaxAmount && passesOrderLimit,
      });

      if (passesMinAmount && passesMaxAmount && passesOrderLimit) {
        discountPercent = Number(rule.discount_percent);
        appliedRule = rule;
        console.log(`${DEBUG_TAG}   ✅ MATCHED rule id=${rule.id} → discountPercent=${discountPercent}`);
        break;
      } else {
        const reasons = [];
        if (!passesMinAmount) reasons.push(`effectiveAmount (${effectiveAmount}) < minAmount (${minAmount})`);
        if (!passesMaxAmount) reasons.push(`effectiveAmount (${effectiveAmount}) > maxAmount (${maxAmount})`);
        if (!passesOrderLimit) reasons.push(`orderCount (${orderCount}) >= orderLimit (${orderLimit})`);
        console.log(`${DEBUG_TAG}   ❌ rule id=${rule.id} FAILED: ${reasons.join(", ")}`);
      }
    }

    if (!appliedRule) {
      console.warn(`${DEBUG_TAG} ⚠️  No discount rule matched. discountPercent stays 0.`);
    }

    // ── Student extra discount ─────────────────────────────
    if (isStudent && appliedRule && Number(appliedRule.student_extra_percent) > 0 && orderCount > 0) {
      const extra = Number(appliedRule.student_extra_percent);
      console.log(`${DEBUG_TAG} 🎓 Student extra discount applied: +${extra}%`);
      discountPercent += extra;
    } else {
      console.log(`${DEBUG_TAG} student extra discount NOT applied:`, {
        isStudent,
        hasAppliedRule: !!appliedRule,
        student_extra_percent: appliedRule ? appliedRule.student_extra_percent : "N/A",
        orderCount,
        reason: !isStudent ? "not a student" : !appliedRule ? "no rule matched" : orderCount === 0 ? "first order (orderCount=0)" : "student_extra_percent is 0",
      });
    }

    if (discountPercent > 100) {
      console.warn(`${DEBUG_TAG} discountPercent capped from ${discountPercent} to 100`);
      discountPercent = 100;
    }

    // ── 7. Calculate totals ────────────────────────────────
    //
    // ✅ FIX: finalPayableAmount = discounted subtotal only (NO service charge baked in)
    //         Flutter adds serviceCharge separately in the UI and order payload
    //         This prevents double-counting the service charge
    //
    const DISCOUNT_FLOOR = 22;
    let discountFloorApplied = false;
    let finalPayableAmount = bookingAmount; // subtotal only, no SC

    console.log(`${DEBUG_TAG} ── CALCULATION ─────────────────────────────`);
    console.log(`${DEBUG_TAG} bookingAmount=${bookingAmount}, discountPercent=${discountPercent}, DISCOUNT_FLOOR=${DISCOUNT_FLOOR}`);

    if (discountPercent > 0) {
      const discounted = bookingAmount * (1 - discountPercent / 100);
      console.log(`${DEBUG_TAG} discounted = ${bookingAmount} × ${(1 - discountPercent / 100).toFixed(4)} = ${discounted}`);

      if (discounted < DISCOUNT_FLOOR) {
        finalPayableAmount = DISCOUNT_FLOOR;
        discountFloorApplied = true;
        console.log(`${DEBUG_TAG} 🔒 Floor applied: ${discounted} < ${DISCOUNT_FLOOR} → finalPayableAmount = ${DISCOUNT_FLOOR}`);
      } else {
        finalPayableAmount = discounted;
        console.log(`${DEBUG_TAG} ✅ No floor needed: finalPayableAmount = ${finalPayableAmount}`);
      }
    } else {
      console.log(`${DEBUG_TAG} discountPercent=0 → no discount, finalPayableAmount = bookingAmount = ${bookingAmount}`);
    }

    // ✅ discountAmount = what customer saves
    const discountAmount = bookingAmount - finalPayableAmount;

    // ✅ finalTotal = finalPayableAmount + serviceCharge (for reference only)
    //    Flutter should compute this itself as: _finalTotal + _serviceCharge
    const finalTotal = finalPayableAmount + serviceCharge;

    console.log(`${DEBUG_TAG} ── FINAL RESULT ────────────────────────────`);
    console.log(`${DEBUG_TAG}`, {
      bookingAmount,
      discountPercent,
      discountAmount: discountAmount.toFixed(2),
      finalPayableAmount: finalPayableAmount.toFixed(2),
      discountFloorApplied,
      serviceCharge,
      finalTotal: finalTotal.toFixed(2),
      minTopupApplied,
      topupAmount,
      note: "finalTotal = finalPayableAmount + serviceCharge (Flutter adds SC separately)",
    });

    // ── 8. Build response ──────────────────────────────────
    const mode = minTopupApplied
      ? "below_minimum"
      : discountPercent > 0
      ? "discount"
      : "no_discount";

    const isExpress = orderHasDiscountFlag === true;
    const isNormal = !isExpress;

    console.log(`${DEBUG_TAG} ── RESPONSE mode=${mode} ─────────────────────`);

    return res.json({
      success: true,
      mode,
      message:
        mode === "below_minimum"
          ? `Minimum top-up of ₹${topupAmount.toFixed(2)} applied.`
          : mode === "discount"
          ? `Discount of ${discountPercent}% applied.`
          : "No discount available.",
      subtotal: bookingAmount.toFixed(2),
      orderCount,
      discountPercent: discountPercent.toFixed(2),
      discountAmount: discountAmount.toFixed(2),
      serviceCharge: serviceCharge.toFixed(2),
      minimumOrderAmount: minimumOrderAmount.toFixed(2),
      minTopupApplied,
      topupAmount: topupAmount.toFixed(2),
      discountFloorApplied,
      // ✅ finalPayableAmount = subtotal after discount, WITHOUT service charge
      // Flutter adds serviceCharge on top: displayTotal = finalPayableAmount + serviceCharge
      finalPayableAmount: finalPayableAmount.toFixed(2),
      // finalTotal kept for convenience but Flutter must NOT add SC again on top of it
      finalTotal: finalTotal.toFixed(2),
      appliedDiscountRule: appliedRule
        ? {
            minAmount: appliedRule.min_amount,
            maxAmount: appliedRule.max_amount,
            discountPercent: appliedRule.discount_percent,
            orderLimit: appliedRule.order_limit,
          }
        : null,
      isExpress,
      isNormal,
    });
  } catch (err) {
    console.error(`${DEBUG_TAG} ❌ UNCAUGHT ERROR:`, err);
    return res.json({ success: false, message: "Internal server error" });
  }
});


