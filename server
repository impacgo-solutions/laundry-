// Several lsp screens (order detail: cancel, confirm pickup, mark delivered,
// reschedule requests) are shared UI reached by BOTH the driver and manager
// roles - authenticateDriver/authenticateManager alone would reject whichever
// role's token doesn't match that specific table, so this dispatches on the
// token's own `role` claim (present on every manager/driver JWT since login
// issues them from the same /lm/check endpoint) to the matching table check.
const authenticateDriverOrManager = async (req, res, next) => {
  const authHeader = req.headers.authorization;

  if (!authHeader || !authHeader.startsWith('Bearer ')) {
    return res.status(401).json({
      success: false,
      message: 'Authorization token required'
    });
  }

  try {
    const token = authHeader.split(' ')[1];
    const decoded = jwt.verify(token, JWT_SECRET);

    if (decoded.role === 'driver') {
      const result = await pool.query('SELECT * FROM driver WHERE driver_id = $1', [decoded.id]);
      if (result.rows.length === 0) {
        return res.status(401).json({ success: false, message: 'Invalid or unauthorized driver' });
      }
      req.driver = result.rows[0];
      req.user = { id: result.rows[0].driver_id, role: 'driver' };
      return next();
    }

    if (decoded.role === 'manager') {
      const result = await pool.query('SELECT * FROM laundrymanager WHERE user_id = $1', [decoded.id]);
      if (result.rows.length === 0) {
        return res.status(401).json({ success: false, message: 'Invalid token user' });
      }
      req.user = { id: result.rows[0].user_id, role: 'manager' };
      return next();
    }

    return res.status(401).json({ success: false, message: 'Invalid token role' });
  } catch (err) {
    return res.status(401).json({
      success: false,
      message: 'Invalid or expired token'
    });
  }
};

